		}
		{
			dependencies: ["77A098B5C5C1B2CB"]
			description: ["&#19E6E6Zykna:&r &oCada receta es un recuerdo que el mundo todavía guarda. Probar un plato de cada comida disponible es juntar esos recuerdos uno por uno, sin que se pierdan.", "", "&6Qué hacer:&r Come un plato de cada comida de Farmer's Delight. Lleva la cuenta en tu libro de recetas y prepara lo que falte.", "", "&6Premio:&r 2 cosas al azar: una manzana dorada, esmeraldas, oro o un diamante.", "&5A veces (7 %):&r dos manzanas doradas."]
			disable_toast: true
