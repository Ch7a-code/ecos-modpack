					title: "Llega al Templo de la Conciencia"
					type: "gamestage"
				}
			]
			title: "El Templo, a escala real"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["31A0A99D4B529D43"]
			description: ["&#19E6E6Zykna:&r &oEl Bosque Crepuscular es un bolsillo de memoria: un mundo que un fragmento recordó, y su portal es una cicatriz. En la maqueta se ve tranquilo. Adentro, no tanto.", "", "&6Qué hacer:&r Abre el portal del Bosque Crepuscular (un estanque rodeado de flores al que se le arroja un diamante) y cruza a su dimensión.", "", "&6Premio:&r 2 cosas al azar: lingotes de madera de hierro, bayas antorcha, plumas de cuervo o pan.", "&5A veces (7 %):&r un pico de hierro encantado con Eficiencia."]
			disable_toast: true
			icon: "twilightforest:ironwood_ingot"
			id: "10D0E2F47C167BC2"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "60725C4D1E899020"
					icon: "twilightforest:ironwood_ingot"
					stage: "ecos_l_atlas_crepusculo_pisar"
					title: "Entra al Bosque Crepuscular"
					type: "gamestage"
				}
			]
			title: "El portal del crepúsculo"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["10D0E2F47C167BC2"]
			description: ["&#19E6E6Zykna:&r &oEl atlas muestra casas de montaña bajo la nieve, con humo en las chimeneas. Es gente sin astilla que sigue en pie: no pelea como ustedes, pero los necesita.", "", "&6Qué hacer:&r Encuentra una aldea de montaña de CTOV (casas de madera entre la nieve) y entra a ella.", "", "&6Premio:&r 2 cosas al azar: lana, pan, esmeraldas o linternas.", "&5A veces (7 %):&r un bloque de esmeralda."]
			disable_toast: true
			icon: "minecraft:white_wool"
			id: "5985A84BE4781A8E"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "0A60330F6D8B37B4"
					icon: "minecraft:white_wool"
					stage: "ecos_l_atlas_alpina_pisar"
					title: "Pisa una aldea de montaña"
					type: "gamestage"
				}
			]
			title: "Una aldea entre la nieve"
			x: 0.00d
			y: 2.80d
		}
		{
			dependencies: ["5985A84BE4781A8E"]
			description: ["&#19E6E6Zykna:&r &oRascacielos en ruinas cubiertos de verde: la maqueta no dice si es de antes de la Fractura o de otra era, y las filtraciones traen de ambas. Sus tiendas aún guardan cosas.", "", "&6Qué hacer:&r Encuentra una ciudad perdida de Big Lost City y pisa uno de sus edificios: un rascacielos, la planta de energía, la bodega o la rueda de la fortuna.", "", "&6Premio:&r 2 cosas al azar: hierro, vidrio, latas de comida o esmeraldas.", "&5A veces (7 %):&r un casco de hierro encantado con Protección."]
			disable_toast: true
			icon: "minecraft:iron_block"
			id: "5E0917FC8069B8CF"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
