	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oEn el Búnker hay una maqueta del Templo de la Conciencia, pequeña y completa. El de verdad es enorme y está cerca de donde despertaste. Ve y mide la diferencia.", "", "&6Qué hacer:&r Acércate al Templo de la Conciencia: ponte a 40 bloques de su centro.", "", "&6Premio:&r 2 cosas al azar: velas, oro, esmeraldas o frascos de experiencia.", "&5A veces (7 %):&r dos manzanas doradas."]
			disable_toast: true
			icon: "minecraft:crying_obsidian"
			id: "31A0A99D4B529D43"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
