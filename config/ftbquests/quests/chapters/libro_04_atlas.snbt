				}
			]
			title: "La ciudad perdida"
			x: 0.00d
			y: 4.20d
		}
		{
			dependencies: ["5E0917FC8069B8CF"]
			description: ["&#19E6E6Zykna:&r &oEn la sabana vive una tribu que honra a un ave del sol. La maqueta los muestra en su santuario, quietos. En persona conviene llegar con respeto y la espada envainada.", "", "&6Qué hacer:&r Busca en la sabana la arboleda de los Umvuthana (Mowzie's Mobs) y entra en ella.", "", "&6Premio:&r 2 cosas al azar: cobre, oro, frascos de experiencia o pan.", "&5A veces (7 %):&r un escudo encantado con Irrompibilidad."]
			disable_toast: true
			icon: "minecraft:sunflower"
			id: "04A3B6AAAD2E202D"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "29CA671EEAE19F9E"
