					id: "6F939F7A002E1434"
					icon: "minecraft:moss_block"
					stage: "ecos_l_atlas_cuevas_pisar"
					title: "Llega a las Cuevas Primordiales"
					type: "gamestage"
				}
			]
			title: "La selva bajo el mundo"
			x: 0.00d
			y: 7.00d
		}
		{
			dependencies: ["6495356E5FB9ACF7"]
			description: ["&#19E6E6Zykna:&r &oLa maqueta del Nether es lava y piedra roja detrás de un cristal. Es el otro lado del mismo mundo, y el calor no perdona: ahí también vive un Portador.", "", "&6Qué hacer:&r Construye un portal de obsidiana, enciéndelo y cruza al Nether.", "", "&6Premio:&r 2 cosas al azar: obsidiana, carbón, cuarzo o piedra de alma.", "&5A veces (7 %):&r unas botas de hierro encantadas con Caída de pluma."]
			disable_toast: true
			icon: "minecraft:netherrack"
			id: "6D8F1A1470F31E8B"
			shape: "circle"
			size: 1.00d
