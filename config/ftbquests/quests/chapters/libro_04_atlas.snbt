		}
		{
			dependencies: ["6D8F1A1470F31E8B"]
			description: ["&#19E6E6Zykna:&r &oPuentes, torres y un mar de lava: la fortaleza fue de lo primero que pusieron en el atlas. Ahí se junta lo que en ningún otro lugar del Nether se encuentra.", "", "&6Qué hacer:&r Dentro del Nether, encuentra una fortaleza y entra a ella.", "", "&6Premio:&r 2 cosas al azar: polvo de blaze, verruga del Nether, oro o hierro.", "&5A veces (7 %):&r un peto de hierro encantado con Protección."]
			disable_toast: true
			icon: "minecraft:nether_bricks"
			id: "574AB10270923406"
