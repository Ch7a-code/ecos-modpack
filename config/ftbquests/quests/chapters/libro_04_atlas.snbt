		}
		{
			dependencies: ["56BC84422E121980"]
			description: ["&#19E6E6Zykna:&r &oEl Aether es otro bolsillo de memoria: islas flotando sobre un mar de nubes, y un portal azul que es una cicatriz. En la maqueta las nubes parecen de algodón.", "", "&6Qué hacer:&r Abre el portal del Aether (un marco de piedra luminosa que se enciende con agua) y entra a su dimensión.", "", "&6Premio:&r 2 cosas al azar: zanita, ámbar dorado, bayas azules o palos de skyroot.", "&5A veces (7 %):&r unas botas de hierro encantadas con Caída de pluma."]
			disable_toast: true
