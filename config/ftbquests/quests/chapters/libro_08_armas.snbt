		}
		{
			dependencies: ["67FA8E77F82FD95B"]
			description: ["&#19E6E6Zykna:&r &oUn arma tirada en un cofre se raya y se pierde. Una vitrina o un tablero de pared la deja a la vista y a la mano. Es orden, y también respeto por algo que cuesta fabricar.", "", "&6Qué hacer:&r Pon una vitrina o un tablero de armas de TACZ en tu refugio y guarda un arma.", "", "&6Premio:&r 2 cosas al azar: hierro, cobre, pólvora o balas .45.", "&5A veces (7 %):&r un cargador extendido ligero."]
			disable_toast: true
			icon: "tacz:gun_display_case"
			id: "23B45CA774C842F3"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
