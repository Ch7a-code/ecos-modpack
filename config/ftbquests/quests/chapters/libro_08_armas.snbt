		}
		{
			dependencies: ["623BAE26FEFA7BA4"]
			description: ["&#19E6E6Zykna:&r &oAlgunas armas no se llevan, se plantan: ametralladoras que escupen sin parar y pistolas del tamaño de un martillo. Pesan, gastan y avisan a todo lo que oiga. Úsalas cuando valga la pena el ruido.", "", "&6Qué hacer:&r Empuña una ametralladora (M249, PKM, RPK o Minigun) y una pistola pesada (Desert Eagle, Rhino, Taurus 500 y otras).", "", "&6Premio:&r 2 cosas al azar: balas 7.62, oro, diamante o pólvora.", "&5A veces (7 %):&r un cargador extendido grande."]
			disable_toast: true
			icon: "tacz:modern_kinetic_gun"
