	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oCon la Era I vuelven las armas de fuego, y con ellas la mesa donde se ensamblan. Cada arma es un plano que se llena con hierro, cobre y pólvora, y sale lista para usarse. Empieza por la mesa.", "", "&6Qué hacer:&r Fabrica una mesa de armero de TACZ y ponla en tu refugio. Ábrela con clic derecho para ver los planos de armas.", "", "&6Premio:&r 2 cosas al azar: hierro, cobre, pólvora o balas de 9 mm.", "&5A veces (7 %):&r una caja de munición."]
			disable_toast: true
			icon: "tacz:gun_smith_table"
			id: "0810EEFA79A1605C"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "10C63392BE1D7FA5"
					icon: "tacz:gun_smith_table"
					stage: "ecos_l_armas_mesa_poner"
					title: "Pon una mesa de armero"
					type: "gamestage"
				}
			]
			title: "La mesa de armero"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["0810EEFA79A1605C"]
			description: ["&#19E6E6Zykna:&r &oLa Era I solo abre las pistolas ligeras: poco alcance, poco peso y mucha práctica. No son un arma de ejército; son lo que el Proyecto dejaba a quien cuidaba un pasillo. Aprende a recargar sin pensar.", "", "&6Qué hacer:&r Arma una pistola ligera en la mesa de armero (Glock 17, M1911, CZ 75, P320 y similares) y empuñala. Recarga con R y apunta con clic derecho.", "", "&6Premio:&r 2 cosas al azar: hierro, pólvora, cobre o balas de 9 mm.", "&5A veces (7 %):&r un láser compacto para tu pistola."]
			disable_toast: true
			icon: "tacz:modern_kinetic_gun"
			id: "30831B4E6FBEED1C"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "427E6EECBBB157BF"
					icon: "tacz:modern_kinetic_gun"
					stage: "ecos_l_armas_pistola_empunar"
					title: "Empuña una pistola"
					type: "gamestage"
				}
			]
			title: "Una pistola en la mano"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["30831B4E6FBEED1C"]
			description: ["&#19E6E6Zykna:&r &oUn arma sin munición es un palo caro. La munición se fabrica en la mesa de armero y se guarda en cajas que la acomodan por tipo. Cuenta lo que gastas: la Fractura no recarga.", "", "&6Qué hacer:&r Fabrica munición en la mesa de armero y arma una caja de munición para guardarla ordenada.", "", "&6Premio:&r 2 cosas al azar: hierro, cobre, pólvora o balas .45.", "&5A veces (7 %):&r 64 balas de 9 mm."]
			disable_toast: true
			icon: "tacz:ammo_box"
			id: "67FA8E77F82FD95B"
			shape: "circle"
			size: 1.00d
