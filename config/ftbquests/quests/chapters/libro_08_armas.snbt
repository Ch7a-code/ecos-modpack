		}
		{
			dependencies: ["4FD03C647D63A681"]
			description: ["&#19E6E6Zykna:&r &oEn la Era III las armas de precisión: tiradores, francotiradores, fusiles de cerrojo. Se mueven despacio, apuntan largo y dejan al enemigo sin respuesta. Mira lejos antes de disparar.", "", "&6Qué hacer:&r Empuña un tirador (SKS, MK14, SPR) y un francotirador (AWP, M700, Kar98, M107, M95 u otros).", "", "&6Premio:&r 2 cosas al azar: balas .308, oro, diamante o pólvora.", "&5A veces (7 %):&r una mira de francotirador."]
			disable_toast: true
			icon: "tacz:modern_kinetic_gun"
			id: "623BAE26FEFA7BA4"
			shape: "diamond"
			size: 1.00d
