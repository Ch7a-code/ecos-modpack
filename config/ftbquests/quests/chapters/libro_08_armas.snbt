		}
		{
			dependencies: ["23B45CA774C842F3"]
			description: ["&#19E6E6Zykna:&r &oLa Era II abre las armas que mandan cuando el enemigo está cerca. Las escopetas dispersan el daño y los subfusiles lo multiplican. Distinto alcance, distinto ruido, distinto momento.", "", "&6Qué hacer:&r Empuña una escopeta (M870, M1014, SPAS-12, AA-12 o de dos cañones) y un subfusil (MP5, MP7, P90, UMP45, Uzi o Vector).", "", "&6Premio:&r 2 cosas al azar: hierro, oro, pólvora o cartuchos de escopeta.", "&5A veces (7 %):&r un estrangulador de escopeta."]
			disable_toast: true
			icon: "tacz:modern_kinetic_gun"
			id: "7D92A8191B767183"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
