	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oUna mesa de encantar sola hace poco. Rodeada de estanterías, la magia se concentra y sube de nivel. Cada librero que acomodas es una página más del Éter que se queda en tu cuarto.", "", "&6Qué hacer:&r Pon una estantería junto a una mesa de encantamientos. Con Apotheosis puedes llenar hasta 15 de ellas alrededor.", "", "&6Premio:&r 2 cosas al azar: libros, papel, lapislázuli o cuero.", "&5A veces (7 %):&r un libro encantado con Eficiencia."]
			disable_toast: true
			icon: "minecraft:bookshelf"
			id: "0D770AF4C8FD7FC5"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
