		}
		{
			dependencies: ["2043F28911D4A7A7"]
			description: ["&#19E6E6Zykna:&r &oMás arriba de lo épico hay un escalón al que casi nadie llega: lo mítico. Un objeto así no se compra ni se encuentra en un cofre cualquiera. Cae de los jefes más duros, o de la suerte de siglos.", "", "&6Qué hacer:&r Encuentra un objeto de afijo mítico. Se consigue venciendo a jefes de Apotheosis o con mucha suerte en los monstruos más fuertes.", "", "&6Premio:&r 2 cosas al azar: diamantes, oro, chatarra de netherita o frascos de experiencia.", "&5A veces (7 %):&r tres diamantes."]
			disable_toast: true
