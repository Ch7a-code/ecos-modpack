		}
		{
			dependencies: ["46DFE16CF21F129E"]
			description: ["&#19E6E6Zykna:&r &oUna gema cruda sirve, pero cortada rinde más. La mesa de corte de gemas sube una calidad con dos piezas parecidas y polvo de gema. Con la Era II ya tienes de dónde sacar piezas buenas.", "", "&6Qué hacer:&r Fabrica una Mesa de Corte de Gemas, ponla y mejora una gema de Apotheosis con ella.", "", "&6Premio:&r 2 cosas al azar: oro, esmeraldas, polvo de gema o un diamante.", "&5A veces (7 %):&r dos diamantes."]
			disable_toast: true
			icon: "apotheosis:gem_cutting_table"
			id: "43E722C7EA76664C"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
