		}
		{
			dependencies: ["03F14398ED2F40B3"]
			description: ["&#19E6E6Zykna:&r &oCon los Cielos abiertos, la gente sin astilla quiere saber más. Una biblioteca enseña a leer y a contar; una universidad enseña a investigar; un hospital cuida de quien se lastima.", "", "&6Qué hacer:&r Construye una biblioteca. Después pon una universidad y un hospital cerca de ella.", "", "&6Premio:&r 2 cosas al azar: libros, esmeraldas, oro o lapislázuli.", "&5A veces (7 %):&r una mesa de encantamientos."]
			disable_toast: true
