		}
		{
			dependencies: ["1362630D92D7AADB"]
			description: ["&#19E6E6Zykna:&r &oTus colonos te piden cosas con calma: un pico, un montón de tablas. No es mendigar, es que confían en que tú sí puedes con lo que a ellos les cuesta días. Cumple una petición.", "", "&6Qué hacer:&r Abre el taller del constructor con clic derecho, mira sus solicitudes y entrégale lo que pide con los botones del menú.", "", "&6Premio:&r 2 cosas al azar: hierro, carbón, cuero o cobre.", "&5A veces (7 %):&r un pico de hierro encantado con Irrompibilidad."]
			disable_toast: true
			icon: "minecraft:chest"
			id: "3D655FFA6F8B26B0"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "48356198FD70D8E1"
					icon: "minecraft:chest"
					stage: "ecos_l_colonia_pedidos_cumplir"
					title: "Cumple una solicitud de tu constructor"
					type: "gamestage"
