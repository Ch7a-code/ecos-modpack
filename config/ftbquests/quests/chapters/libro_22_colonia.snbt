		}
		{
			dependencies: ["1E2091A13AAF9B20"]
			description: ["&#19E6E6Zykna:&r &oHay colonos que, después de la Fractura, dicen oír cosas en las noches claras. Un lugar místico les da un sitio donde escuchar sin miedo, y a la colonia un orgullo que no se compra.", "", "&6Qué hacer:&r Construye un lugar místico y súbelo a nivel 5.", "", "&6Premio:&r 2 cosas al azar: oro, esmeraldas, frascos de experiencia o velas.", "&5A veces (7 %):&r un montón de frascos de experiencia."]
			disable_toast: true
