					icon: "minecolonies:supplycampdeployer"
					stage: "ecos_l_colonia_campamento_armar"
					title: "Fabrica el campamento de suministros"
					type: "gamestage"
				}
			]
			title: "Un campamento de suministros"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["2A801149DC0926C5"]
			description: ["&#19E6E6Zykna:&r &oUna colonia sin centro se deshace con la primera noche mala. El Ayuntamiento lleva la cuenta de quién vive aquí, quién come y quién falta. Que se termine de construir.", "", "&6Qué hacer:&r Coloca el Ayuntamiento con la herramienta de construcción, entrega al constructor lo que pida y espera a que quede terminado.", "", "&6Premio:&r 2 cosas al azar: tablones, piedra, esmeraldas o libros.", "&5A veces (7 %):&r un bloque de esmeralda."]
			disable_toast: true
			icon: "minecolonies:blockhuttownhall"
			id: "0C6750DA0DADE12C"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "4B5720A3E7FF85DD"
					icon: "minecolonies:blockhuttownhall"
					stage: "ecos_l_colonia_ayuntamiento_terminar"
					title: "Termina el Ayuntamiento"
					type: "gamestage"
				}
			]
			title: "La pieza central"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["0C6750DA0DADE12C"]
			description: ["&#19E6E6Zykna:&r &oUn Eco puede poner un muro; una colonia necesita a alguien que levante diez. El constructor trabaja con lo que le lleves, y cada cosa que levanta es un lugar más donde la gente se queda.", "", "&6Qué hacer:&r Coloca el taller del constructor, contrata a un colono y entrégale los materiales que te pida hasta que termine su primera obra.", "", "&6Premio:&r 2 cosas al azar: hierro, troncos, piedra o antorchas.", "&5A veces (7 %):&r un pico de hierro encantado con Eficiencia."]
			disable_toast: true
			icon: "minecolonies:blockhutbuilder"
			id: "00417E9D984B6C0C"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "22CFE003F862F370"
					icon: "minecolonies:blockhutbuilder"
					stage: "ecos_l_colonia_constructor_taller"
