	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oLos que sobrevivieron sin astilla no pelean como ustedes, pero los necesitan, y ustedes a ellos. Para empezar con ellos hace falta un lugar donde reunirse: un campamento de suministros.", "", "&6Qué hacer:&r Fabrica un campamento de suministros de MineColonies y colócalo con clic derecho en el suelo, en un terreno llano y despejado.", "", "&6Premio:&r 2 cosas al azar: troncos, tablones, antorchas o pan.", "&5A veces (7 %):&r un cofre de hierro de Sophisticated Storage."]
			disable_toast: true
			icon: "minecolonies:supplycampdeployer"
			id: "2A801149DC0926C5"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
