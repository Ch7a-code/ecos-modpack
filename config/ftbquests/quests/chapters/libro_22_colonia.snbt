		}
		{
			dependencies: ["2B297A071BCDB6F2"]
			description: ["&#19E6E6Zykna:&r &oDiez no son una multitud, pero ya son un asentamiento: gente con cara, nombre y oficio que se levanta antes que el sol. Con eso ya puedes dejar de preguntarte si va a durar.", "", "&6Qué hacer:&r Haz crecer tu colonia hasta 10 colonos.", "", "&6Premio:&r 2 cosas al azar: pan, camas, hierro o esmeraldas.", "&5A veces (7 %):&r un montón de esmeraldas."]
			disable_toast: true
