	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oNo todas las criaturas que cruzaron la Fractura son enemigas. Algunas solo tienen hambre y miedo, y se quedan con quien les da de comer. Empieza por la más curiosa: un mono con un plátano en la mano.", "", "&6Qué hacer:&r Consigue bananas y domestica un mono capuchino dándole bananas. Si lo logras, te sigue y se queda contigo.", "", "&6Premio:&r 2 cosas al azar: plátanos, manzanas, correas o pan.", "&5A veces (7 %):&r una montura de silla de montar."]
			disable_toast: true
			icon: "alexsmobs:banana"
			id: "39EED549601FD026"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
