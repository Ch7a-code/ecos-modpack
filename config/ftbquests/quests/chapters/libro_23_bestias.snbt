		{
			dependencies: ["7A355C37BD1B3E2B"]
			description: ["&#19E6E6Zykna:&r &oLos dragones llegaron por la Fractura de otra era, y su huevo es lo único que de ellos se puede cargar sin sangre. Con el Éxodo vuelven a ser posibles: hay que incubar uno y darle de comer para que crezca.", "", "&6Qué hacer:&r Consigue un huevo de dragón y fabrica harina de dragón para hacer crecer a una cría.", "", "&6Premio:&r 2 cosas al azar: diamantes, esmeraldas, huesos de dragón o experiencia.", "&5A veces (7 %):&r un diamante."]
			disable_toast: true
