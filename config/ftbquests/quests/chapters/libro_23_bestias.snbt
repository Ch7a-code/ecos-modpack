		}
		{
			dependencies: ["559093D62E74F423"]
			description: ["&#19E6E6Zykna:&r &oUna criatura domada que se pierde es una criatura que no vuelves a ver. Un collar y una escritura de propiedad dicen de quién es cada una, y le dan al mundo la oportunidad de respetarlo.", "", "&6Qué hacer:&r Fabrica una etiqueta de collar y una escritura de propiedad de Domestication Innovation. Ten ambas en tu inventario.", "", "&6Premio:&r 2 cosas al azar: correas, nombres de etiqueta, huesos o hierro.", "&5A veces (7 %):&r una silla de montar."]
			disable_toast: true
			icon: "domesticationinnovation:collar_tag"
			id: "2C0C0E998AFD2C7A"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
