	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oEl Aether es un bolsillo de memoria: un fragmento recordó un cielo entero, y ahí se cristalizó el Éter. Se entra por una cicatriz que brilla. Pisa con cuidado: aquí abajo no hay suelo.", "", "&6Qué hacer:&r Enciende el portal del Aether (marco de piedra luminosa con agua dentro) y cruza.", "", "&6Premio:&r 2 cosas al azar: pan, bayas azules, fragmentos de ambrosio o hierro.", "&5A veces (7 %):&r ámbar dorado."]
			disable_toast: true
			icon: "aether:aether_portal_frame"
			id: "32798C70BBFCFAFA"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "000A2187C293D2D7"
					icon: "aether:aether_portal_frame"
					stage: "ecos_l_cielos_aether_entrar"
					title: "Entra al Aether"
					type: "gamestage"
				}
			]
			title: "La isla que recordó el cielo"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["32798C70BBFCFAFA"]
			description: ["&#19E6E6Zykna:&r &oLo que flota necesita un lugar donde asentarse. El altar trabaja las piedras del cielo y las convierte en cosas útiles. Hazte uno antes de pedirle nada.", "", "&6Qué hacer:&r Fabrica un altar del Aether.", "", "&6Premio:&r 2 cosas al azar: fragmentos de ambrosio, gemas de zanita, piedra sagrada o hierro.", "&5A veces (7 %):&r un pico de zanita encantado con Eficiencia."]
			disable_toast: true
			icon: "aether:altar"
			id: "1D745E23AEC02F0A"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "66EE0E96B8080166"
					icon: "aether:altar"
					stage: "ecos_l_cielos_altar_altar"
					title: "Fabrica un altar"
					type: "gamestage"
				}
			]
			title: "El altar de la gravitita"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["1D745E23AEC02F0A"]
			description: ["&#19E6E6Zykna:&r &oLas moas corren por el cielo como si fuera suelo. Con un huevo y una incubadora tendrás una propia, y ella te llevará más lejos de lo que tus pies recuerdan.", "", "&6Qué hacer:&r Consigue un huevo de moa y haz que nazca en una incubadora.", "", "&6Premio:&r 2 cosas al azar: bayas azules, semillas de trigo, ámbar dorado o pan.", "&5A veces (7 %):&r un huevo de moa blanca."]
			disable_toast: true
			icon: "aether:blue_moa_egg"
			id: "5C1837E00053C1C0"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
