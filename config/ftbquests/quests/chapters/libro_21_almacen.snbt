		}
		{
			dependencies: ["3CE5672C40D303EF"]
			description: ["&#19E6E6Zykna:&r &oUna mochila vacía solo carga. Con mejoras, recoge lo que cae, te da de comer y arma cosas por ti. Un Eco que explora mucho aprende pronto que las manos de su mochila valen más que las suyas.", "", "&6Qué hacer:&r Consigue una mejora de recolección o de imán y una mejora de alimentación o de mesa de trabajo, de Sophisticated Backpacks. Ponlas en tu mochila.", "", "&6Premio:&r 2 cosas al azar: cuero, hilo, redstone o hierro.", "&5A veces (7 %):&r una mochila de cobre."]
			disable_toast: true
			icon: "sophisticatedbackpacks:magnet_upgrade"
			id: "1FA9E7090A4DAC7B"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "2ED0869B88660920"
					icon: "sophisticatedbackpacks:magnet_upgrade"
					stage: "ecos_l_almacen_manos_recoger"
					title: "Consigue una mejora de recolección o de imán"
