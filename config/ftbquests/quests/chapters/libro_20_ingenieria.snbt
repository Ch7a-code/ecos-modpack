		}
		{
			dependencies: ["3157E40F0774EBF9"]
			description: ["&#19E6E6Zykna:&r &oCon pegamento y un rodamiento, un edificio gira, una pared sube, un molino cosecha. Es el truco de las máquinas del Proyecto: no solo hacer cosas, sino hacer que lo hecho se mueva.", "", "&6Qué hacer:&r Pega varios bloques con pegamento. Arma un artilugio móvil (con un rodamiento mecánico, un pistón o una polea) que lleve taladros, sierras o cosechadoras.", "", "&6Premio:&r 2 cosas al azar: pegamento, hierro, cobre o redstone.", "&5A veces (7 %):&r un pico de hierro encantado con Eficiencia."]
			disable_toast: true
			icon: "create:mechanical_bearing"
			id: "5B4D21186964BBB7"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "0FEC867EBC9EDA8D"
					icon: "create:super_glue"
					stage: "ecos_l_ingenieria_artilugios_pegamento"
					title: "Pega varios bloques"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "4DDF59D1E11C5D4E"
					icon: "create:mechanical_drill"
					stage: "ecos_l_ingenieria_artilugios_actores"
					title: "Mueve taladros, sierras o cosechadoras"
					type: "gamestage"
				}
			]
			title: "Cosas que se mueven solas"
			x: 2.50d
			y: 2.80d
		}
		{
			dependencies: ["5B4D21186964BBB7"]
			description: ["&#19E6E6Zykna:&r &oOtra idea del Proyecto: doblar el espacio y guardar una habitación dentro de un bloque. Es poca cosa por fuera y un cuarto entero por dentro, y ahí caben máquinas que de otro modo ocuparían una colina.", "", "&6Qué hacer:&r Consigue una máquina compacta diminuta (la más chica) y el dispositivo de reducción personal, que te enseña a usarla.", "", "&6Premio:&r 2 cosas al azar: hierro, vidrio, redstone o cobre.", "&5A veces (7 %):&r una máquina compacta diminuta."]
			disable_toast: true
			icon: "compactmachines:machine_tiny"
			id: "7CED9525996443E1"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "477AD4434F55DAB7"
					icon: "compactmachines:machine_tiny"
					stage: "ecos_l_ingenieria_minimundo_cubo"
					title: "Ten una máquina compacta diminuta"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "63EC43F164C59720"
