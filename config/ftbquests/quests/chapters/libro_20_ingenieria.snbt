		}
		{
			dependencies: ["5FFE9A3590286938"]
			description: ["&#19E6E6Zykna:&r &oUna rueda de agua se queda corta cuando hay que mover una fábrica entera. El vapor no se queja: un quemador de Blaze, una caldera y un motor te dan fuerza que el viento no te da.", "", "&6Qué hacer:&r Consigue un quemador de Blaze, arma una caldera con agua y colócale un motor de vapor para generar torque.", "", "&6Premio:&r 2 cosas al azar: oro, esmeraldas, carbón o láminas de cobre.", "&5A veces (7 %):&r un pico de diamante encantado con Eficiencia."]
			disable_toast: true
			icon: "create:steam_engine"
			id: "49E801225F00FD0A"
