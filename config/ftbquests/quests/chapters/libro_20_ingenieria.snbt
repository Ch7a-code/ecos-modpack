	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oEl Proyecto Éter movía el mundo con máquinas, y las ruinas todavía guardan sus planos. Todo empieza con una aleación: andesita, hierro y un poco de paciencia.", "", "&6Qué hacer:&r Consigue una aleación de andesita, y úsala sobre un tronco sin corteza para hacer una cubierta de andesita.", "", "&6Premio:&r 2 cosas al azar: aleación de andesita, ejes, engranes o hierro.", "&5A veces (7 %):&r una llave inglesa y unas gafas del ingeniero."]
			disable_toast: true
			icon: "create:andesite_alloy"
			id: "2B48BFA58620EFAC"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
