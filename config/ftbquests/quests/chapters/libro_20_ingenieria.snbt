		}
		{
			dependencies: ["64E6F5DA593D1588"]
			description: ["&#19E6E6Zykna:&r &oEl Taller del Búnker 7 se abre en esta Era, y con él un metal más fino: latón, cobre y zinc fundidos en una mezcladora. Las máquinas que vienen después ya no se hacen con andesita.", "", "&6Qué hacer:&r Alea cobre y zinc en una mezcladora mecánica sobre una cuenca para hacer lingotes de latón, y úsalos sobre un tronco sin corteza para hacer una cubierta de latón.", "", "&6Premio:&r 2 cosas al azar: zinc, cobre, láminas de cobre o latón.", "&5A veces (7 %):&r un mecanismo de precisión."]
			disable_toast: true
			icon: "create:brass_ingot"
			id: "5791791B963F3580"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
