		}
		{
			dependencies: ["5791791B963F3580"]
			description: ["&#19E6E6Zykna:&r &oUn desplegador hace lo que tus manos hacen: poner, clavar, golpear. Una vez que lo pones, no se cansa. Dos ensambladores en fila fabrican lo que antes armabas pieza por pieza.", "", "&6Qué hacer:&r Pon y da energía a un desplegador. Luego coloca y activa un grupo de ensambladores mecánicos para fabricar un objeto.", "", "&6Premio:&r 2 cosas al azar: hierro, redstone, latón o láminas de latón.", "&5A veces (7 %):&r un desplegador."]
			disable_toast: true
			icon: "create:deployer"
			id: "3157E40F0774EBF9"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "35A66AC02321CCCB"
					icon: "create:deployer"
					stage: "ecos_l_ingenieria_desplegador_desplegador"
					title: "Pon y activa un desplegador"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "744E32AC2834541A"
					icon: "create:mechanical_crafter"
					stage: "ecos_l_ingenieria_desplegador_ensamblador"
					title: "Activa ensambladores mecánicos"
					type: "gamestage"
				}
			]
			title: "El reflejo perfecto"
			x: 2.50d
