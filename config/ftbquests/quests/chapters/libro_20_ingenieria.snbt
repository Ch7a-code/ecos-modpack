		}
		{
			dependencies: ["2540B019DE280201"]
			description: ["&#19E6E6Zykna:&r &oA veces no hace falta una máquina lista, solo mover mucho a la vez. Un pistón múltiple empuja una pared entera con un solo bloque: otra pieza del Proyecto que se rescató de las ruinas.", "", "&6Qué hacer:&r Coloca un pistón múltiple en una construcción de tu base y haz que mueva una pared o un techo.", "", "&6Premio:&r 2 cosas al azar: oro, esmeraldas, redstone o pistones.", "&5A veces (7 %):&r un pistón múltiple extra."]
			disable_toast: true
			icon: "multipiston:multipistonblock"
			id: "7623D1D69B87D236"
			shape: "square"
