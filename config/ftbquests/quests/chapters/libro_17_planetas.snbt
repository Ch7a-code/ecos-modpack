					id: "0CB90F0B5F237504"
					icon: "ad_astra:compressor"
					stage: "ecos_l_planetas_presion_comp"
					title: "Construye un Compresor"
					type: "gamestage"
				}
			]
			title: "Todo se aplana"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["2A4EE14A1E05483A"]
			description: ["&#19E6E6Zykna:&r &oEl hierro común no aguanta el vacío. Hace falta acero, y el acero pide un alto horno que coma energía. Aquí las ruinas dejan de ser ruinas y vuelven a ser fábrica.", "", "&6Qué hacer:&r Construye un Alto horno etriónico (Ad Astra) para fundir acero.", "", "&6Premio:&r 2 cosas al azar: carbón, hierro, cobre, redstone o lingotes de acero.", "&5A veces (7 %):&r un pico de hierro encantado con Irrompibilidad."]
			disable_toast: true
			icon: "ad_astra:etrionic_blast_furnace"
			id: "0F134C5E21ECFCF4"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "25DF01DE70488E93"
