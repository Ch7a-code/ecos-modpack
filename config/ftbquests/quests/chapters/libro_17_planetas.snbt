	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oEl Proyecto no llegó a las naves de un salto: llegó con un generador de carbón y mucha paciencia. Antes de pensar en cohetes, aprende a hacer tu propia luz.", "", "&6Qué hacer:&r Construye un Generador de carbón (Ad Astra) y enciéndelo con carbón.", "", "&6Premio:&r 2 cosas al azar: carbón, hierro, cobre, redstone o placas de hierro.", "&5A veces (7 %):&r un pico de hierro encantado con Eficiencia."]
			disable_toast: true
			icon: "ad_astra:coal_generator"
			id: "76BDD26F61A50D1F"
