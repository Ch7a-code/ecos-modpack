	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oLos dones de los Ecos se visten: trajes, telas y mecanismos hechos para la astilla. La Tailoring Bench de Palladium es donde se cose todo eso. Conseguirla es aprender el oficio.", "", "&6Qué hacer:&r Consigue una Tailoring Bench (mesa de sastrería de Palladium) y tenla contigo.", "", "&6Premio:&r 2 cosas al azar: telas de colores, hilo, cuero o lana.", "&5A veces (7 %):&r un cofre de hierro de Sophisticated Storage."]
			disable_toast: true
			icon: "palladium:tailoring_bench"
