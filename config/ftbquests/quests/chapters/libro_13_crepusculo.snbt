			]
			title: "La Hidra de la guarida"
			x: 5.00d
			y: 0.00d
		}
		{
			dependencies: ["13B99E793AE2AE1C"]
			description: ["&#19E6E6Zykna:&r &oEn la fortaleza de los caballeros, el recuerdo quedó atrapado con la armadura puesta: los Caballeros Fantasma vigilan una tumba que nadie nombra. Acomódalos y llévate su metal.", "", "&6Qué hacer:&r Entra a la fortaleza de los caballeros, vence a los Caballeros Fantasma y deja su tumba en paz.", "", "&6Premio:&r 2 cosas al azar: lingotes de metal de caballero, oro, esmeraldas o un diamante.", "&5A veces (7 %):&r un pico de metal de caballero encantado con Eficiencia."]
			disable_toast: true
			icon: "twilightforest:knight_phantom_trophy"
			id: "0A31E7D5B9EE0F42"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
					id: "72D46E0DDDCAE4FC"
					icon: "twilightforest:knight_phantom_trophy"
					stage: "ecos_l_crepusculo_caballeros_matar"
					title: "Acomoda a los Caballeros Fantasma"
					type: "gamestage"
				}
			]
			title: "Fantasmas con armadura"
			x: 5.00d
			y: 1.40d
		}
		{
			dependencies: ["0A31E7D5B9EE0F42"]
			description: ["&#19E6E6Zykna:&r &oEn lo alto de su torre llora un Ur-Ghast enorme, y sus lágrimas queman. Es la memoria de un Ghast que se quedó atorado en un solo dolor. Cuando caiga, toca las lágrimas y llévate lo que quede.", "", "&6Qué hacer:&r Sube a la torre del Ur-Ghast, véncelo y toca sus lágrimas ardientes.", "", "&6Premio:&r 2 cosas al azar: diamantes, oro, carminita o lágrimas de Ghast.", "&5A veces (7 %):&r un trozo de chatarra de netherita."]
			disable_toast: true
			icon: "twilightforest:ur_ghast_trophy"
			id: "451167EDB911EB8F"
			shape: "diamond"
			size: 1.00d
			subtitle: "Era III · El Éxodo"
			tasks: [
				{
					disable_toast: true
