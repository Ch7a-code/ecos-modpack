					stage: "ecos_l_crepusculo_lich_matar"
					title: "Vence al Lich"
					type: "gamestage"
				}
			]
			title: "La torre del Lich"
			x: 2.50d
			y: 0.00d
		}
		{
			dependencies: ["4C324E5D0A28206F"]
			description: ["&#19E6E6Zykna:&r &oBajo tierra hay un laberinto que huele a hongos y a carne guisada. Su guardián, el Minoshroom, parece haber sido otra cosa antes de recordar únicamente esto. Dentro hay una bóveda con un pico que rompe paredes.", "", "&6Qué hacer:&r Entra al laberinto, vence al Minoshroom y encuentra el pico en la bóveda secreta.", "", "&6Premio:&r 2 cosas al azar: galletas del laberinto, estofado de Meef, carne cocida o hierro.", "&5A veces (7 %):&r un hacha de minotauro encantada con Filo."]
			disable_toast: true
			icon: "twilightforest:minoshroom_trophy"
			id: "380EFDFB688E7399"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
