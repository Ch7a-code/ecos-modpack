	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oEl Bosque Crepuscular no es un lugar: es un recuerdo que un fragmento de la Primera Mente no quiso soltar. Por eso su portal parece una cicatriz y la luz nunca termina de caer. Entra con cuidado: aquí las cosas recuerdan.", "", "&6Qué hacer:&r Abre el portal del Bosque Crepuscular (un estanque rodeado de flores y un diamante lanzado al agua) y entra.", "", "&6Premio:&r 2 cosas al azar: antorchas, pan, bayas de antorcha o hierro.", "&5A veces (7 %):&r una espada de madera de hierro encantada con Filo."]
			disable_toast: true
			icon: "twilightforest:twilight_portal_miniature_structure"
			id: "32B46B90B050EFDB"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "34811A7F95EA7309"
					icon: "twilightforest:twilight_portal_miniature_structure"
					stage: "ecos_l_crepusculo_entrar_entrar"
					title: "Entra al Bosque Crepuscular"
					type: "gamestage"
				}
			]
			title: "Una cicatriz en el bosque"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["32B46B90B050EFDB"]
			description: ["&#19E6E6Zykna:&r &oAquí las brújulas mienten y los caminos se doblan. Un mapa mágico se llena con lo que recorres, y uno de minerales te cuenta lo que hay bajo tus pies. Es la forma más amable de no perderte en un recuerdo ajeno.", "", "&6Qué hacer:&r Fabrica un mapa mágico y un mapa de minerales del Bosque Crepuscular.", "", "&6Premio:&r 2 cosas al azar: papel, una brújula, hierro o pan.", "&5A veces (7 %):&r un catalejo."]
			disable_toast: true
			icon: "twilightforest:magic_map"
			id: "701E7ACC0D7303BC"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "121835B8E032160F"
					icon: "twilightforest:magic_map"
					stage: "ecos_l_crepusculo_mapa_magico"
					title: "Fabrica un mapa mágico"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "370CFFA94178E307"
					icon: "twilightforest:ore_map"
					stage: "ecos_l_crepusculo_mapa_minerales"
					title: "Fabrica un mapa de minerales"
					type: "gamestage"
				}
			]
			title: "El mapa que se dibuja solo"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["701E7ACC0D7303BC"]
			description: ["&#19E6E6Zykna:&r &oLo que el bosque recuerda, lo recuerda por piezas. La mesa de desfabricar desarma un objeto en los materiales que lo formaron: tira lo que ya no sirve y recupera lo que vale.", "", "&6Qué hacer:&r Fabrica una mesa de desfabricar. Sirve para desarmar un objeto en sus materiales.", "", "&6Premio:&r 2 cosas al azar: hierro, cobre, redstone o pedernal.", "&5A veces (7 %):&r un pico de hierro encantado con Eficiencia."]
			disable_toast: true
			icon: "twilightforest:uncrafting_table"
			id: "78ADCA294C7DADFD"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "04C69E500E1B5BF8"
					icon: "twilightforest:uncrafting_table"
					stage: "ecos_l_crepusculo_mesa_mesa"
					title: "Ten una mesa de desfabricar"
					type: "gamestage"
				}
			]
			title: "Deshacer para rehacer"
			x: 0.00d
			y: 2.80d
		}
		{
			dependencies: ["78ADCA294C7DADFD"]
			description: ["&#19E6E6Zykna:&r &oLos fragmentos grandes de la Primera Mente se metieron en los cuerpos más fuertes. Aquí uno vive dentro de la Naga, que defiende su patio como quien defiende un recuerdo. Con ella y el Lich caídos, el mundo puede subir a la Era I.", "", "&6Qué hacer:&r Vence a la Naga en su patio, recoge su escama y fabrica la armadura de pecho y de piernas de Naga.", "", "&6Premio:&r Ninguno aparte: esta misma acción ya paga en «Escamas de Naga» (Armaduras, escudos y cuerpo) y «La serpiente del patio» (Los Portadores).", "&5A veces (7 %):&r un peto de Naga encantado con Protección."]
			disable_toast: true
			icon: "twilightforest:naga_scale"
			id: "5FD0B0F6B906AA36"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "304FE4E5541F6E15"
					icon: "twilightforest:naga_scale"
					stage: "ecos_l_crepusculo_naga_matar"
					title: "Vence a la Naga"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "009FBA34C83ECCAE"
					icon: "twilightforest:naga_chestplate"
					stage: "ecos_l_crepusculo_naga_armadura"
					title: "Fabrica la armadura de Naga"
					type: "gamestage"
				}
			]
			title: "La Naga del patio"
			x: 0.00d
			y: 4.20d
		}
		{
			dependencies: ["5FD0B0F6B906AA36"]
			description: ["&#19E6E6Zykna:&r &oEl Lich guarda en lo alto de su torre un fragmento que aún habla como mago. Junto a la Naga, es lo que el Templo pide para encender el Cimiento. Sube, véncelo y recupera un cetro.", "", "&6Qué hacer:&r Sube a la torre del Lich, véncelo y recupera un cetro. Con él y la Naga caídos, el mundo puede subir a la Era I tras el ritual del Cimiento.", "", "&6Premio:&r Ninguno aparte: esta misma acción ya paga en «El Lich de la torre» (Los Portadores).", "&5A veces (7 %):&r un pico de madera de hierro encantado con Eficiencia."]
			disable_toast: true
			icon: "twilightforest:lich_trophy"
			id: "4C324E5D0A28206F"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
