	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oCuando la Primera Mente se rompió, los fragmentos más grandes se metieron en los cuerpos más fuertes: así nacieron los Portadores. El Caballero de Hierro Forjado es el primero que guarda un camino; cuando cae, cuenta para todo el mundo.", "", "&6Qué hacer:&r Derrota a un Ferrous Wroughtnaut (caballero de hierro forjado) de Mowzie. Pelea con espacio y esquiva su hacha: pega fuerte y despacio.", "", "&6Premio:&r 2 cosas al azar: lingotes de hierro, carne cocida, cobre o esmeraldas.", "&5A veces (7 %):&r una pechera de hierro encantada con Protección."]
			disable_toast: true
			icon: "mowziesmobs:wrought_axe"
			id: "0B469C11450CF396"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "703F761914A45A17"
					icon: "mowziesmobs:wrought_axe"
					stage: "ecos_l_portadores_herrero_matar"
					title: "Derrota al Ferrous Wroughtnaut"
					type: "gamestage"
				}
			]
			title: "El que forja sin descanso"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["0B469C11450CF396"]
			description: ["&#19E6E6Zykna:&r &oEn el Bosque Crepuscular, un fragmento recordó una serpiente que guarda un patio y no deja pasar. Es otro Portador: más viejo que el hierro y con el mismo hambre. Cuando cae, las barreras mágicas del bosque ceden.", "", "&6Qué hacer:&r Derrota a la Naga en su patio del Bosque Crepuscular.", "", "&6Premio:&r 2 cosas al azar: lingotes de hierro, carne cocida, cobre o esmeraldas.", "&5A veces (7 %):&r una espada de hierro encantada con Filo."]
			disable_toast: true
			icon: "twilightforest:naga_trophy"
			id: "3FA447EE0DCCA7AC"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "0E9EA6B278895BEF"
					icon: "twilightforest:naga_trophy"
					stage: "ecos_l_portadores_naga_matar"
					title: "Derrota a la Naga"
					type: "gamestage"
				}
			]
			title: "La serpiente del patio"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["3FA447EE0DCCA7AC"]
			description: ["&#19E6E6Zykna:&r &oUn fragmento de la Primera Mente se quedó atrapado en una torre con un rey que ya no respira. El Lich guarda cuatro cetros; cada uno es una voz distinta de lo que quedó. Cuando la torre calla, el mundo sube una Era.", "", "&6Qué hacer:&r Mata al Lich en lo alto de su torre del Bosque Crepuscular y recupera uno de sus cetros.", "", "&6Premio:&r 2 cosas al azar: lingotes de hierro, carne cocida, cobre o esmeraldas.", "&5A veces (7 %):&r unas botas de hierro encantadas con Protección."]
			disable_toast: true
			icon: "twilightforest:lich_spawn_egg"
			id: "070217160C73C1E8"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "5FCBE271F3F2BAD0"
					icon: "twilightforest:lich_spawn_egg"
					stage: "ecos_l_portadores_lich_matar"
					title: "Derrota al Lich y recupera un cetro"
					type: "gamestage"
				}
			]
			title: "El Lich de la torre"
			x: 0.00d
			y: 2.80d
		}
		{
			dependencies: ["070217160C73C1E8"]
			description: ["&#19E6E6Zykna:&r &oLa Hidra es un fragmento que aprendió a regenerarse: cada cabeza que le cortas nace de nuevo si no la aprovechas. Dos Portadores tienen que caer para que la Era II se abra, y ella es uno.", "", "&6Qué hacer:&r Derrota a la Hidra del Bosque Crepuscular. Evita que sus cabezas te muerdan en grupo y ataca la que se acaba de regenerar.", "", "&6Premio:&r 2 cosas al azar: oro, esmeraldas, un diamante o carne asada.", "&5A veces (7 %):&r una espada de diamante encantada con Filo."]
			disable_toast: true
			icon: "twilightforest:hydra_spawn_egg"
			id: "07665748FEEAFAB5"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
					id: "52AB9D6178929EB1"
					icon: "twilightforest:hydra_spawn_egg"
					stage: "ecos_l_portadores_hidra_matar"
					title: "Derrota a la Hidra"
					type: "gamestage"
				}
			]
			title: "Cabezas que vuelven"
			x: 2.50d
			y: 0.00d
		}
		{
			dependencies: ["07665748FEEAFAB5"]
			description: ["&#19E6E6Zykna:&r &oEn el Nether, un fragmento se metió en una armadura de máquina y se quedó dentro. La Monstruosidad de netherita es el segundo Portador de la Era II: lenta, pesada y con un puño que parte rocas.", "", "&6Qué hacer:&r Derrota a la Monstruosidad de netherita de Cataclysm. Guarda distancia para sus bombas y no te quedes quieto cuando alce el brazo.", "", "&6Premio:&r 2 cosas al azar: oro, esmeraldas, un diamante o lingotes de hierro.", "&5A veces (7 %):&r un trozo de netherita."]
			disable_toast: true
			icon: "cataclysm:netherite_monstrosity_spawn_egg"
			id: "1920AB5355B21D3E"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
					id: "4B928E960C1CB5E8"
