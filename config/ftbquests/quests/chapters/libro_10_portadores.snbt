		}
		{
			dependencies: ["753882B0F3D3174B"]
			description: ["&#19E6E6Zykna:&r &oEn el End vive un Portador que no pidió serlo: el Dragón. La Era III no sube sin él. Cuando cae, en el centro del vacío queda un huevo, y con él, lo que queda por decidir.", "", "&6Qué hacer:&r Derrota al Dragón del End.", "", "&6Premio:&r 2 cosas al azar: diamantes, esmeraldas, oro o perlas de Ender.", "&5A veces (7 %):&r dos o tres diamantes."]
			disable_toast: true
