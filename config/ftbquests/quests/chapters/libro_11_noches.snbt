					stage: "ecos_l_noches_clave_puerta"
					title: "Pon una puerta de teclado"
					type: "gamestage"
				}
			]
			title: "Una puerta con clave"
			x: 0.00d
			y: 2.80d
		}
		{
			dependencies: ["2FD96A51D0701A0A"]
			description: ["&#19E6E6Zykna:&r &oLos muertos de la Fractura no se van del todo: se quedan en sus tumbas esperando que alguien los nombre. Un ankh de oración les da paz y a ti te da algo que la experiencia no enseña.", "", "&6Qué hacer:&r Haz un ankh de oración de Tombstone y úsalo sobre una tumba. Sirve la tuya o la de cualquier otro.", "", "&6Premio:&r 2 cosas al azar: polvo de tumba, polvo de desaparición, lingotes de hierro o pan.", "&5A veces (7 %):&r un muñeco vudú."]
			disable_toast: true
			icon: "tombstone:ankh_of_prayer"
			id: "05D541D92F0694AD"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "44BA7B5B01E06A13"
					icon: "tombstone:ankh_of_prayer"
					stage: "ecos_l_noches_rezo_orar"
					title: "Reza sobre una tumba con un ankh"
					type: "gamestage"
				}
			]
			title: "Una oración por los tuyos"
			x: 2.50d
			y: 0.00d
		}
		{
			dependencies: ["05D541D92F0694AD"]
			description: ["&#19E6E6Zykna:&r &oDefender es ver antes que el enemigo. Una cámara en la puerta y un monitor adentro te dejan mirar la noche sin salir a ella. Lo que no ves te sorprende; lo que ves ya lo estás esperando.", "", "&6Qué hacer:&r Consigue una cámara de seguridad y un monitor de cámaras de SecurityCraft. Pon la cámara en la entrada y enlázala con el monitor.", "", "&6Premio:&r 2 cosas al azar: hierro, redstone, vidrio o antorchas.", "&5A veces (7 %):&r un portatarjetas de SecurityCraft."]
			disable_toast: true
			icon: "securitycraft:security_camera"
			id: "2E44C6D8958F54C1"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "1D9B7AA4FC474029"
					icon: "securitycraft:security_camera"
					stage: "ecos_l_noches_camara_camara"
					title: "Consigue una cámara de seguridad"
					type: "gamestage"
				}
				{
					disable_toast: true
