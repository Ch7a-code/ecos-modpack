					stage: "ecos_l_noches_mirada_verlo"
					title: "Mira a Herobrine por primera vez"
					type: "gamestage"
				}
			]
			title: "Algo te sigue"
			x: 2.50d
			y: 4.20d
		}
		{
			dependencies: ["6DE347BA710B84F3"]
			description: ["&#19E6E6Zykna:&r &oAlgunas noches no llega una criatura: llega una marcha. Los muertos se levantan juntos, con armas y con orden. Aguantar una noche así separa un refugio de una fortaleza.", "", "&6Qué hacer:&r Derrota al ejército de los muertos vivientes de Majrusz. Aparece de noche en zonas abiertas; prepara una zona de combate con luz y salidas.", "", "&6Premio:&r 2 cosas al azar: esmeraldas, oro, flechas o una manzana dorada.", "&5A veces (7 %):&r una espada de diamante encantada con Filo."]
			disable_toast: true
			icon: "minecraft:zombie_head"
			id: "3A97686583C73889"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
					id: "7D6C858B1175C167"
					icon: "minecraft:zombie_head"
					stage: "ecos_l_noches_ejercito_derrotar"
					title: "Derrota al ejército de muertos vivientes"
					type: "gamestage"
