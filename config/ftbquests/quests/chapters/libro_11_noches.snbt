					stage: "ecos_l_noches_experto_modo"
					title: "El mundo entra en modo Maestro"
					type: "gamestage"
				}
			]
			title: "El mundo se endurece"
			x: 7.50d
			y: 0.00d
		}
		{
			dependencies: ["5F565FEE8E0AC655"]
			description: ["&#19E6E6Zykna:&r &oEntre las criaturas que cruzaron hay algunas que no vienen a matar, vienen a asustar. El acechador de pesadillas y el invocador supremo se alimentan del miedo de quien camina sin luz.", "", "&6Qué hacer:&r Mata al Nightmare Stalker y al Supreme Bonescaller de Born in Chaos. Llega con armadura buena, luz de sobra y comida.", "", "&6Premio:&r 2 cosas al azar: diamante, esmeraldas, chatarra de netherita o manzanas doradas.", "&5A veces (7 %):&r una espada de diamante encantada con Aspecto Ígneo."]
			disable_toast: true
			icon: "minecraft:soul_lantern"
			id: "7680D5599FD2ABCF"
			shape: "diamond"
			size: 1.00d
			subtitle: "Era III · El Éxodo"
