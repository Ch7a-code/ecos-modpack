			]
			title: "El ejército de los muertos"
			x: 5.00d
			y: 0.00d
		}
		{
			dependencies: ["3A97686583C73889"]
			description: ["&#19E6E6Zykna:&r &oEl Éter viaja por el sonido, y bajo la tierra el sonido nunca se acaba. Algo aprendió a vivir ahí: oye cada paso y sale cuando crees estar a salvo. No lo busques haciendo ruido.", "", "&6Qué hacer:&r Baja a una cueva con poca luz y mata a la criatura de las cuevas de Cave Dweller. Entra callado, con un arma buena y una salida cerca.", "", "&6Premio:&r 2 cosas al azar: esmeraldas, oro, carne cocida o antorchas.", "&5A veces (7 %):&r una pechera de hierro encantada con Protección."]
			disable_toast: true
			icon: "minecraft:sculk_sensor"
			id: "6BDC4C9C4DE0BC81"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
					id: "4440B63B5FB3E7B7"
					icon: "minecraft:sculk_sensor"
					stage: "ecos_l_noches_cueva_matar"
					title: "Mata a la criatura de las cuevas"
					type: "gamestage"
				}
			]
			title: "El que vive en las cuevas"
			x: 5.00d
			y: 1.40d
		}
		{
			dependencies: ["6BDC4C9C4DE0BC81"]
			description: ["&#19E6E6Zykna:&r &oCuando la noche trae muchos, ya no basta una puerta. Una mina enterrada y un centinela con arma convierten tu refugio en una trampa que no duerme. Que lo que entre sin permiso lo lamente.", "", "&6Qué hacer:&r Pon una mina o un IMS de SecurityCraft frente a tu entrada y consigue un centinela. Pon la mina lejos de tu puerta para no pisarla tú.", "", "&6Premio:&r 2 cosas al azar: esmeraldas, oro, hierro o redstone.", "&5A veces (7 %):&r una tarjeta de acceso de nivel 2."]
			disable_toast: true
			icon: "securitycraft:mine"
			id: "76241D897486F15D"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
					id: "0723F558EC70B414"
					icon: "securitycraft:mine"
					stage: "ecos_l_noches_trampas_mina"
					title: "Pon una mina o un IMS"
