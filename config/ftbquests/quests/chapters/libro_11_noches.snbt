	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oTu cuerpo es un clon hecho de prisa y se rompe. Cuando caes, el mundo levanta una tumba donde caíste y guarda ahí tu equipo. No es un castigo: es una promesa de que vuelves por él.", "", "&6Qué hacer:&r Cuando caigas, se levanta una tumba en ese lugar. Vuelve a ella y recupera tus cosas. La misión cuenta el logro Tu primera tumba de Tombstone.", "", "&6Premio:&r 2 cosas al azar: pan, antorchas, flechas o un polvo de desaparición.", "&5A veces (7 %):&r una llave de tumba, para abrir la tuya sin pelear."]
			disable_toast: true
			icon: "tombstone:grave_key"
			id: "27235EAD78FDB52B"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "6594F6C33EFB65B0"
					icon: "tombstone:grave_key"
					stage: "ecos_l_noches_tumba_primera"
					title: "Se levanta tu primera tumba"
					type: "gamestage"
				}
			]
			title: "Lo que queda de ti"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["27235EAD78FDB52B"]
			description: ["&#19E6E6Zykna:&r &oEn esta dificultad las heridas sangran y el cuerpo no se acuerda de cerrarlas. Una venda de tela y un poco de calma te devuelven el pulso. Un Eco que sabe vendarse llega más lejos.", "", "&6Qué hacer:&r Deja que algo te haga sangrar y detén el sangrado con una venda de Majrusz. Se hace con tela; si no la tienes, consíguela de las arañas.", "", "&6Premio:&r 2 cosas al azar: vendas, hilo, pan o manzanas.", "&5A veces (7 %):&r una venda dorada."]
			disable_toast: true
			icon: "majruszsdifficulty:bandage"
			id: "498ADE0E0323DC98"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "29F2BA4B14BA1DFD"
					icon: "minecraft:redstone"
					stage: "ecos_l_noches_vendas_sangrar"
					title: "Sangra por primera vez"
					type: "gamestage"
				}
				{
