					stage: "ecos_l_noches_camara_monitor"
					title: "Consigue un monitor de cámaras"
					type: "gamestage"
				}
			]
			title: "Ojos en la entrada"
			x: 2.50d
			y: 1.40d
		}
		{
			dependencies: ["2E44C6D8958F54C1"]
			description: ["&#19E6E6Zykna:&r &oOtras eras se filtran por la Fractura y traen sus propios muertos. Los invocadores de huesos no pelean: mandan. Si cae el que manda, sus esqueletos se deshacen como si nunca hubieran estado.", "", "&6Qué hacer:&r Mata a un Bonescaller de Born in Chaos. Sale de noche y se reconoce porque levanta esqueletos pequeños a su alrededor.", "", "&6Premio:&r 2 cosas al azar: huesos, flechas, hierro o carne cocida.", "&5A veces (7 %):&r un arco encantado con Poder."]
			disable_toast: true
			icon: "minecraft:bone"
			id: "7EE8B21346B4971F"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "511FE5CC68714EC5"
					icon: "minecraft:bone"
					stage: "ecos_l_noches_huesos_matar"
					title: "Mata a un Bonescaller"
					type: "gamestage"
				}
			]
			title: "Los que levantan huesos"
			x: 2.50d
			y: 2.80d
		}
		{
			dependencies: ["7EE8B21346B4971F"]
			description: ["&#19E6E6Zykna:&r &oDesde que llegaste cuentas los días, y a veces el día cuenta de vuelta. Hay una figura que aparece lejos y no se acerca. No ataca. Eso es lo que más inquieta.", "", "&6Qué hacer:&r Sobrevive 3 días de juego y mira a Herobrine de lejos por primera vez. No lo persigas: míralo y regresa a tu refugio.", "", "&6Premio:&r 2 cosas al azar: antorchas, pan, linternas o carne cocida.", "&5A veces (7 %):&r una brújula de recuperación."]
			disable_toast: true
			icon: "minecraft:ender_eye"
			id: "6DE347BA710B84F3"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
