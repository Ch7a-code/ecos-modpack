	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oLa Última Domadora dice que una criatura no se doma: se gana. Antes de buscar nidos, escucha su lección, que es para todos los dones.", "", "&6Qué hacer:&r Completa la lección de Ocelotzin en la Gran Ronda y vuelve con ella para cerrarla. Escribe zykna ronda para ver los pasos.", "", "&6Premio:&r 2 cosas al azar: correas, carne cocinada, trigo o cuero.", "&5A veces (7 %):&r una montura de silla de montar."]
			disable_toast: true
