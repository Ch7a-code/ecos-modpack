			]
			title: "El huevo sin romper"
			x: 2.50d
			y: 0.00d
		}
		{
			dependencies: ["1A25916C611A75CB"]
			description: ["&#19E6E6Zykna:&r &oTras el robo, los padres siguen tu rastro unos segundos. Corre, sube a un sitio alto o enfréntalos juntos: cualquier camino sirve, menos quedarte quieto.", "", "&6Qué hacer:&r Sobrevive a la persecución de los padres después de levantar el huevo. Cuando te pierdan el rastro, Zykna te avisa.", "", "&6Premio:&r 2 cosas al azar: hierro, carne cocinada, escudos o cuero.", "&5A veces (7 %):&r un escudo."]
			disable_toast: true
			icon: "minecraft:shield"
			id: "451532ECE33D095B"
