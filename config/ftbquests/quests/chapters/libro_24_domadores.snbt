		}
		{
			dependencies: ["451532ECE33D095B"]
			description: ["&#19E6E6Zykna:&r &oUna cría que nace cerca de ti te toma por familia. Es lo más cerca que está la Fractura de dejar algo vivo sin que sea una amenaza.", "", "&6Qué hacer:&r Coloca el huevo y quédate cerca hasta que eclosione. La cría nace domada y se queda contigo.", "", "&6Premio:&r 2 cosas al azar: paja, carne cocinada, correas o cuero.", "&5A veces (7 %):&r una silla de montar."]
			disable_toast: true
