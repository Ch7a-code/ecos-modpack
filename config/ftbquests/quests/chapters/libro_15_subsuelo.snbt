	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oDebajo de la tierra no hay cielo prestado: la tierra misma recuerda. Una tablilla de las cuevas guarda esa memoria, y la mesa de espeología te enseña a leerla.", "", "&6Qué hacer:&r Encuentra una tablilla en una cabina subterránea y tradúcela en una mesa de espeología.", "", "&6Premio:&r 2 cosas al azar: hierro, antorchas, papel o carbón.", "&5A veces (7 %):&r un compendio de las cuevas."]
			disable_toast: true
			icon: "alexscaves:spelunkery_table"
			id: "1113181DD6845089"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "3CCB41327E3937C8"
