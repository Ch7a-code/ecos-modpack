					title: "Entra a una mazmorra grande"
					type: "gamestage"
				}
			]
			title: "Salas con dueño"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["2895E8C699FDB7D1"]
			description: ["&#19E6E6Zykna:&r &oBajo la superficie hay una cueva donde el tiempo se detuvo: huesos, helechos y criaturas que no deberían existir. Son filtraciones de otra era. Ocelotzin vive en el fondo, y hay que excavar hondo.", "", "&6Qué hacer:&r Entra a las cuevas primordiales y encuentra un dinosaurio.", "", "&6Premio:&r 2 cosas al azar: chuletas de dinosaurio, estrellas arbóreas, huesos o brotes de helecho.", "&5A veces (7 %):&r una cachiporra primitiva."]
			disable_toast: true
			icon: "alexscaves:dinosaur_chop"
			id: "52755E14E0213308"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "6745A6A498E61971"
					icon: "alexscaves:dinosaur_chop"
					stage: "ecos_l_subsuelo_primordiales_entrar"
					title: "Entra a la cueva primordial"
					type: "gamestage"
				}
				{
