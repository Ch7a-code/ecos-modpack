		}
		{
			dependencies: ["1F5469E6E251E3E7"]
			description: ["&#19E6E6Zykna:&r &oOcelotzin, la Última Domadora, vive en el Cuenco de los Huesos, y un Tremorsaurus guarda su hogar. Si tu don es de Bestias, doma uno: aturdido y con ensaladas serenas, deja de ser un guardián y pasa a ser un aliado.", "", "&6Qué hacer:&r Aturde a un Tremorsaurus y dale ensaladas serenas hasta domarlo.", "", "&6Premio:&r 2 cosas al azar: ensaladas serenas, chuletas de dinosaurio, oro o un diamante.", "&5A veces (7 %):&r un casco primordial."]
			disable_toast: true
			icon: "alexscaves:serene_salad"
			id: "02134B0CEF50E098"
