	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oCruzaste. El teletransportador del Búnker 7 ya no responde, y lo que el laboratorio te prestó se quedó allá: aquí solo traes tu astilla y lo que cargabas. Frente a ti está el Templo de la Conciencia. Aquí empieza lo tuyo.", "", "&6Qué hacer:&r Sal del Búnker 7 por la Fractura y llega al Templo de la Conciencia.", "", "&6Premio:&r 2 cosas al azar: antorchas, pan, manzanas o troncos.", "&5A veces (7 %):&r una espada de hierro encantada."]
			disable_toast: true
			icon: "minecraft:echo_shard"
			id: "611CECE0EA414984"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Acto I · Sobrevivir"
			tasks: [
				{
					disable_toast: true
					id: "7B5B83BB9AD06B20"
					icon: "minecraft:echo_shard"
					stage: "ecos_i_llegada_fractura"
					title: "Cruza la Fractura"
					type: "gamestage"
				}
			]
			title: "Del otro lado de la Fractura"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["611CECE0EA414984"]
			description: ["&#19E6E6Zykna:&r &oAquí afuera nadie apaga a las criaturas cuando cae el sol, y la Fractura crece sola: cada noche es un poco peor que la anterior. Antes de pensar en Portadores, piensa en cuatro paredes.", "", "&6Qué hacer:&r Fuera del Búnker, pon una mesa de trabajo, una puerta y una cama.", "", "&6Premio:&r 2 cofres para guardar tus cosas y el material de una mochila (4 cuero, 4 hilo y 1 cofre), más 1 cosa al azar: antorchas, linternas, vidrio o pan.", "&5A veces (7 %):&r un cofre de hierro de Sophisticated Storage, más grande."]
			disable_toast: true
			icon: "minecraft:oak_door"
			id: "489A12B95F656239"
			shape: "circle"
			size: 1.00d
			subtitle: "Acto I · Sobrevivir"
			tasks: [
				{
					disable_toast: true
					id: "567897050F5DABE1"
					icon: "minecraft:crafting_table"
					stage: "ecos_i_refugio_mesa"
					title: "Pon una mesa de trabajo"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "3FBF81156135CA5A"
