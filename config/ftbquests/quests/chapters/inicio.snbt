		}
		{
			dependencies: ["7FC5C3AB5F27FB4C"]
			description: ["&#19E6E6Zykna:&r &oNo todos los que sobrevivieron a la Fractura son Ecos. Hay gente sin astilla que sigue en pie: no pelea como ustedes, pero los necesita, y ustedes a ella. Solos no van a durar.", "", "&6Qué hacer:&r Comercia con un aldeano, o pon el Ayuntamiento de una colonia de MineColonies.", "", "&6Premio:&r 2 cosas al azar: esmeraldas, troncos, pan o libros.", "&5A veces (7 %):&r un bloque de esmeralda."]
			disable_toast: true
			icon: "minecolonies:blockhuttownhall"
			id: "50D78D90ACE59864"
			shape: "square"
			size: 1.00d
			subtitle: "Acto II · Echar raíz"
			tasks: [
				{
					disable_toast: true
					id: "50F5DA0A7258F0FF"
					icon: "minecolonies:blockhuttownhall"
					stage: "ecos_i_gente_trato"
					title: "Comercia o funda una colonia"
					type: "gamestage"
				}
			]
			title: "Los que no tienen astilla"
			x: 3.00d
			y: 2.00d
		}
		{
			dependencies: ["50D78D90ACE59864"]
			description: ["&#19E6E6Zykna:&r &oTu don todavía no te deja volar: eso llega con la marca de tu Maestro. Mientras, el mundo es grande y las piernas no alcanzan. Las naves también son tecnología del Proyecto: ármate una.", "", "&6Qué hacer:&r Arma y maneja fuera del Búnker un avión de Immersive Aircraft, un barco de Small Ships, el rover de Ad Astra o el submarino de Alex's Caves. Las lanchas de madera no cuentan.", "", "&6Premio:&r 3 puntos de habilidad y combustible al azar."]
			disable_toast: true
			icon: "immersive_aircraft:biplane"
			id: "5C69F91D02C5D7EC"
			shape: "square"
			size: 1.00d
			subtitle: "Acto II · Echar raíz"
			tasks: [
				{
					disable_toast: true
					id: "334657A1B80157BA"
					icon: "immersive_aircraft:biplane"
					stage: "ecos_i_vehiculo_manejar"
					title: "Maneja tu vehículo"
					type: "gamestage"
				}
			]
			title: "Algo con qué moverte"
			x: 1.50d
			y: 2.00d
		}
		{
			dependencies: ["5C69F91D02C5D7EC"]
			description: ["&#19E6E6Zykna:&r &oAl cruzar, tu astilla se quedó callada: lo que sabías hacer en el laboratorio era prestado. Cada nivel de Conciencia la despierta un poco y te da puntos para tu árbol. Todo cuenta: pelear, minar, fundir, pescar.", "", "&6Qué hacer:&r Llega a Conciencia 10. Abre Shift + F → Mi Eco para ver cuánto te falta.", "", "&6Premio:&r 2 cosas al azar: frascos de experiencia, lapislázuli o amatista.", "&5A veces (7 %):&r un montón de frascos de experiencia."]
			disable_toast: true
			icon: "minecraft:amethyst_shard"
			id: "119FE285F1B2736A"
			shape: "square"
			size: 1.00d
			subtitle: "Acto II · Echar raíz"
			tasks: [
				{
					disable_toast: true
					id: "1EE06FCECFFB5BA4"
					icon: "minecraft:amethyst_shard"
					stage: "ecos_i_astilla_diez"
					title: "Llega a Conciencia 10"
					type: "gamestage"
				}
			]
			title: "La astilla despierta"
			x: 0.00d
			y: 2.00d
		}
		{
			dependencies: ["119FE285F1B2736A"]
			description: ["&#19E6E6Zykna:&r &oEl Templo de la Conciencia es la única forma de volver a coser a la Primera Mente. Se enciende nivel por nivel, y cada nivel antes de la Cumbre pide ocho ofrendas, una por pilar. Sube a la cima: que una de esas voces sea la tuya.", "", "&6Qué hacer:&r Entrega una ofrenda en el altar de la cima del Templo: clic derecho con ella en la mano. Abre el libro de misiones, capítulo Las Obras para ver qué pide el nivel.", "", "&6Premio:&r 2 cosas al azar: oro, esmeraldas, frascos de experiencia o velas.", "&5A veces (7 %):&r dos manzanas doradas."]
			disable_toast: true
			icon: "minecraft:crying_obsidian"
			id: "41A425EA72C21293"
			shape: "square"
			size: 1.00d
			subtitle: "Acto II · Echar raíz"
			tasks: [
				{
					disable_toast: true
					id: "4FD66D17901F498B"
					icon: "minecraft:crying_obsidian"
					stage: "ecos_i_templo_ofrenda"
					title: "Entrega una ofrenda en el altar"
					type: "gamestage"
				}
			]
			title: "La primera ofrenda"
			x: 0.00d
			y: 4.00d
		}
		{
			dependencies: ["41A425EA72C21293"]
			description: ["&#19E6E6Zykna:&r &oLos fragmentos más grandes de la Primera Mente se metieron en los cuerpos más fuertes: así nacieron los Portadores. Cuando cae el primero y se enciende el Cimiento del Templo, el mundo entero sube a la Era I. Ya no se trata solo de sobrevivir.", "", "&6Qué hacer:&r Entre todos: venzan al Ferrous Wroughtnaut, o a la Naga y al Lich, y enciendan el Cimiento del Templo. Abre el libro de misiones, capítulo Las Obras para ver qué falta.", "", "&6Premio:&r 2 cosas al azar: hierro, pólvora o frascos de experiencia.", "&5A veces (7 %):&r un peto de hierro encantado con Protección."]
			disable_toast: true
			icon: "mowziesmobs:wrought_axe"
			id: "021D2E878FA32987"
			shape: "diamond"
			size: 1.00d
			subtitle: "Acto III · El llamado"
			tasks: [
				{
					disable_toast: true
					id: "0527DC14C8C51D10"
					icon: "mowziesmobs:wrought_axe"
					stage: "ecos_i_resistencia_era1"
					title: "El mundo llega a la Era I"
					type: "gamestage"
				}
			]
			title: "La Resistencia"
			x: 1.50d
			y: 4.00d
		}
		{
			dependencies: ["021D2E878FA32987"]
			description: ["&#19E6E6Zykna:&r &oEl Búnker 7 no está muerto, está herido. Seis salas esperan materiales para volver a funcionar, y cada una que se enciende me devuelve un registro del Proyecto Éter. Hay verdades que solo están ahí.", "", "&6Qué hacer:&r Vuelve al Búnker 7 y entrega material en la terminal de una sala: la lámpara junto a su puerta. La Enfermería y el Taller abren en la Era I. Escribe búnker para ver qué piden.", "", "&6Premio:&r 2 cosas al azar: hierro, cobre o redstone.", "&5A veces (7 %):&r un mecanismo de precisión de Create."]
			disable_toast: true
			icon: "minecraft:redstone_lamp"
			id: "7002E57824CBD582"
			shape: "diamond"
			size: 1.00d
			subtitle: "Acto III · El llamado"
			tasks: [
				{
					disable_toast: true
					id: "551BB484D1107151"
					icon: "minecraft:redstone_lamp"
					stage: "ecos_i_bunker_aporte"
					title: "Aporta a una terminal del Búnker"
					type: "gamestage"
				}
			]
			title: "El Búnker respira"
			x: 3.00d
			y: 4.00d
		}
		{
			dependencies: ["7002E57824CBD582"]
			description: ["&#19E6E6Zykna:&r &oSiete Maestros siguen vivos, uno por familia de dones, cada uno donde pocos llegan. Tu Maestro despierta cuando cae el guardián de su hogar. Llega hasta ahí y acepta su Prueba: lo que sigue ya no te lo enseño yo.", "", "&6Qué hacer:&r Abre Shift + F → Misiones para saber quién es tu Maestro y dónde vive. Vence al guardián de su hogar, habla con tu Maestro y acepta su Prueba.", "", "&6Los siete Maestros:", "&7· Bestias: Ocelotzin, la Última Domadora, en el Cuenco de los Huesos (cuevas primordiales de Alex's Caves: hay que excavar hondo).", "&7· Elementales: Citlali, la Tejedora de Tormentas, en las islas altas del Aether.", "&7· Sangre y cuerpo: Yolotl, la Curandera de Hueso, en el Domo Envenenado de Everdawn (Blue Skies).", "&7· Mente y espacio: Mixtli, el Archivista del Silencio, en la Otra Orilla (Otherside de Deeper and Darker).", "&7· Materia: Tepoztli, el Herrero de la Roca, en las Cuevas de los Gigantes (Tierras Altas del Bosque Crepuscular).", "&7· Espíritu y sombra: Yohualli, el Custodio de la Vela, en la Torre Oscura (Born in Chaos: taiga, bosque o llanura).", "&7· Impulso y adaptación: Cuauhtli, la Corredora de Cielos, en las Islas Altas de Everbright (Blue Skies).", "", "&6Premio:&r 2 cosas al azar: frascos de experiencia, una manzana dorada o esmeraldas.", "&5A veces (7 %):&r una espada de diamante encantada con Filo."]
			disable_toast: true
			icon: "minecraft:compass"
			id: "2F05CBDA56653977"
			shape: "diamond"
			size: 1.25d
			subtitle: "Acto III · El llamado"
			tasks: [
				{
					disable_toast: true
					id: "69689BC95277E7A4"
					icon: "minecraft:compass"
					stage: "ecos_i_maestro_prueba"
					title: "Acepta la Prueba de tu Maestro"
					type: "gamestage"
				}
			]
			title: "La Prueba del Maestro"
			x: 4.50d
			y: 4.00d
		}
		{
			dependencies: ["2F05CBDA56653977"]
			description: ["&#19E6E6Zykna:&r &oLos waystones son la vieja red de relevos del Proyecto Éter. Desde la Era II vuelven a responder: tocas uno y el mundo se hace más chico. Funcionan, pero cobran: cada viaje largo te cuesta niveles de experiencia.", "", "&6Qué hacer:&r Cuando el mundo llegue a la Era II, activa un waystone con clic derecho. Se fabrican, o se encuentran por el mundo.", "", "&6Premio:&r 2 cosas al azar: frascos de experiencia, pergaminos de regreso, polvo de teletransporte o perlas de Ender.", "&5A veces (7 %):&r una piedra de teletransporte que se recarga sola."]
			disable_toast: true
			icon: "waystones:waystone"
			id: "2A9970283770804E"
			shape: "gear"
			size: 1.40d
			subtitle: "Acto III · El llamado"
			tasks: [
				{
					disable_toast: true
					id: "49760B11632BAD9E"
					icon: "waystones:waystone"
					stage: "ecos_i_relevos_waystone"
					title: "Activa un waystone"
					type: "gamestage"
				}
			]
			title: "La vieja red de relevos"
			x: 6.00d
			y: 4.00d
		}
	]
	subtitle: ["Del Búnker 7 al Templo: lo que hace un Eco en sus primeros días.", "Zykna te dice qué sigue. Nada se traba: lo que hagas fuera de orden también cuenta."]
	title: "Los primeros días del Eco"
}
