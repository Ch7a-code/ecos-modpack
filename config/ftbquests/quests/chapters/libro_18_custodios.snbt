	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oLos Custodios llegaron a la Fractura antes que el Proyecto Éter. Al Éter lo llamaron la Fuerza. Lo que dejaron está regado por otros mundos: naves, sables, holocrones. Empieza por el primero.", "", "&6Qué hacer:&r Empieza la aventura de los Custodios (Star Wars Expansion): este logro se abre al comenzar.", "", "&6Premio:&r 2 cosas al azar: diamantes, esmeraldas, créditos galácticos o hierro.", "&5A veces (7 %):&r un pico de diamante encantado con Eficiencia."]
			disable_toast: true
			icon: "star_wars_expansion:holocron"
			id: "5607F78F7B9D11F3"
			shape: "hexagon"
