		}
		{
			dependencies: ["3B8314700CB99412"]
			description: ["&#19E6E6Zykna:&r &oUn Custodio no viaja a pie. Sus naves cruzan el espacio de un salto. Consigue una, colócala, súbete y abre el mapa galáctico con la tecla Z para elegir adónde ir.", "", "&6Qué hacer:&r Consigue un X-Wing o un TIE Fighter, colócalo y súbete. Con la tecla Z abres el mapa galáctico.", "", "&6Premio:&r 2 cosas al azar: diamantes, esmeraldas, créditos galácticos o hierro.", "&5A veces (7 %):&r una pechera de diamante encantada con Protección."]
			disable_toast: true
