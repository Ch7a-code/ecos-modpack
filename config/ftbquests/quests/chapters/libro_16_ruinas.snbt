	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oLos cofres de las ruinas son ecos del pasado: lo que guardaban se quedó esperando a cada Eco por separado. Lo que tú saques no le quita nada a nadie más.", "", "&6Qué hacer:&r Abre un cofre de botín en unas ruinas (Lootr). Cada jugador ve su propio contenido.", "", "&6Premio:&r 2 cosas al azar: lingotes de hierro, pan, antorchas, flechas o una esmeralda.", "&5A veces (7 %):&r una pala de hierro encantada con Eficiencia."]
			disable_toast: true
