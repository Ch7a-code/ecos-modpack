			title: "Primeros auxilios"
			x: 0.00d
			y: 4.20d
		}
		{
			dependencies: ["44A14DFDC42FFFAC"]
			description: ["&#19E6E6Zykna:&r &oEl clima de aquí no perdona a un cuerpo hecho de prisa: arde de día y se congela de noche. En la Mesa de costura le coses aislamiento a la armadura y el cuerpo deja de pelear contra el aire.", "", "&6Qué hacer:&r Pon una Mesa de costura de Cold Sweat y aísla una pieza de armadura con ella.", "", "&6Premio:&r 2 cosas al azar: lana, cuero, hilo o carbón.", "&5A veces (7 %):&r un casco de piel de cabra."]
			disable_toast: true
			icon: "cold_sweat:sewing_table"
			id: "108D03AAC3389194"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "0902959AC030F721"
					icon: "cold_sweat:sewing_table"
					stage: "ecos_l_armaduras_frio_mesa"
					title: "Pon una Mesa de costura"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "15B11F72E524CD88"
					icon: "minecraft:leather_chestplate"
					stage: "ecos_l_armaduras_frio_aislar"
					title: "Aísla una pieza de armadura"
					type: "gamestage"
				}
			]
			title: "Forrar la armadura"
			x: 0.00d
			y: 5.60d
		}
		{
			dependencies: ["108D03AAC3389194"]
			description: ["&#19E6E6Zykna:&r &oEl Bosque Crepuscular es un bolsillo de memoria: un mundo que un fragmento recordó. Lo que cae allí pesa igual que en cualquier otro lado. Las escamas de la Naga dan una armadura ligera y buena para aguantar.", "", "&6Qué hacer:&r Derrota a la Naga en el Bosque Crepuscular y fabrica el peto y los pantalones de escamas de Naga.", "", "&6Premio:&r 2 cosas al azar: lingotes de hierro, escamas de Naga, pan o esmeraldas.", "&5A veces (7 %):&r unos pantalones de Naga encantados con Protección."]
			disable_toast: true
			icon: "twilightforest:naga_chestplate"
			id: "0B7919F0C5B62601"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "62E399B76FFF1E04"
					icon: "twilightforest:naga_leggings"
					stage: "ecos_l_armaduras_naga_armar"
					title: "Fabrica la armadura de Naga"
					type: "gamestage"
				}
			]
			title: "Escamas de Naga"
			x: 2.50d
			y: 0.00d
		}
		{
			dependencies: ["0B7919F0C5B62601"]
			description: ["&#19E6E6Zykna:&r &oLa Enfermería del Búnker 7 ya tiene luz, y con ella la morfina: hay heridas que una venda no cierra. No es un juguete; guárdala para el momento en que de verdad se acabe la vida.", "", "&6Qué hacer:&r Ten una dosis de morfina de First Aid en el inventario, para las heridas que las vendas no alcanzan.", "", "&6Premio:&r 2 cosas al azar: vendas, morfina, curitas o hierro.", "&5A veces (7 %):&r dos dosis de morfina."]
			disable_toast: true
			icon: "firstaid:morphine"
			id: "2A64871FD871BDFB"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
			tasks: [
				{
					disable_toast: true
					id: "185EB94183FCC6FB"
					icon: "firstaid:morphine"
					stage: "ecos_l_armaduras_morfina_morfina"
					title: "Ten una dosis de morfina"
					type: "gamestage"
				}
			]
			title: "Lo que una venda no cierra"
			x: 2.50d
			y: 1.40d
		}
		{
			dependencies: ["2A64871FD871BDFB"]
			description: ["&#19E6E6Zykna:&r &oEl Aether es otro bolsillo de memoria, un cielo que alguien recordó sin guerra. Sus metales no se funden como los de aquí: el Altar es la forja de ese lugar, y sus piezas se hacen a mano.", "", "&6Qué hacer:&r Fabrica un Altar del Aether y úsalo para conseguir gravitita encantada.", "", "&6Premio:&r Ninguno aparte: esta misma acción ya paga en «El altar de la gravitita» (Los cielos de memoria) y «El rosa es el nuevo azul» (Los cielos de memoria).", "&5A veces (7 %):&r una manzana dorada."]
			disable_toast: true
			icon: "aether:altar"
			id: "78607A91700312D4"
			shape: "circle"
			size: 1.00d
			subtitle: "Era I · La Resistencia"
