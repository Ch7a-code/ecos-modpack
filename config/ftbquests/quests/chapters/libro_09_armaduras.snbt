		}
		{
			dependencies: ["484E02E3326F4E7E"]
			description: ["&#19E6E6Zykna:&r &oLas naves y los cohetes son tecnología del Proyecto, reconstruida desde las ruinas. Allá arriba no hay aire ni abrigo: un traje espacial es lo único que separa tus pulmones del vacío.", "", "&6Qué hacer:&r Fabrica un traje espacial de Ad Astra (casco, traje, pantalones y botas).", "", "&6Premio:&r 2 cosas al azar: oro, esmeraldas, lingotes de hierro o carbón.", "&5A veces (7 %):&r un diamante."]
			disable_toast: true
