	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oTu cuerpo de Eco se hizo de prisa y se nota: cualquier garra lo abre como papel. Una pieza de hierro no te vuelve intocable, pero entre el golpe y tú ya hay algo.", "", "&6Qué hacer:&r Fabrica una pieza de armadura de hierro (casco, peto, pantalones o botas) y póntela.", "", "&6Premio:&r 2 cosas al azar: lingotes de hierro, carbón, pan o cuero.", "&5A veces (7 %):&r una pechera de hierro encantada con Protección."]
			disable_toast: true
			icon: "minecraft:iron_chestplate"
			id: "00BB543630E0BE9B"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "688CB47AD1F58CF7"
					icon: "minecraft:iron_chestplate"
					stage: "ecos_l_armaduras_hierro_pieza"
					title: "Ponte una pieza de armadura de hierro"
					type: "gamestage"
				}
			]
			title: "Hierro sobre la piel"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["00BB543630E0BE9B"]
			description: ["&#19E6E6Zykna:&r &oCon Shield Expansion hay escudos desde la madera hasta la netherita, y cada nivel aguanta más. Levántalo a tiempo y el golpe no te toca; el escudo es la armadura que decides cuándo usar.", "", "&6Qué hacer:&r Ten un escudo (de madera, hierro, oro o el de siempre) y desvía un proyectil con él: levántalo cuando la flecha ya viene hacia ti.", "", "&6Premio:&r 2 cosas al azar: flechas, hierro, tablas de roble o un escudo de madera.", "&5A veces (7 %):&r un escudo de hierro de Shield Expansion encantado con Irrompibilidad."]
			disable_toast: true
			icon: "minecraft:shield"
			id: "19910FF2703E36B0"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
