			]
			title: "La magia del Aether"
			x: 2.50d
			y: 2.80d
		}
		{
			dependencies: ["78607A91700312D4"]
			description: ["&#19E6E6Zykna:&r &oLa gravitita se siente ligera hasta que te cae encima el primer golpe. Un set completo es raro porque cuesta paciencia: cada pieza es una vuelta más por el Altar.", "", "&6Qué hacer:&r Ten el set completo de armadura de gravitita (casco, peto, pantalones y botas) en tu inventario.", "", "&6Premio:&r 2 cosas al azar: oro, esmeraldas, un diamante o lingotes de hierro.", "&5A veces (7 %):&r una manzana dorada encantada."]
			disable_toast: true
			icon: "aether:gravitite_chestplate"
			id: "17CB76DCB4CCB433"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
