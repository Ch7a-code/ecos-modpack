					stage: "ecos_l_armaduras_escudo_desviar"
					title: "Desvía un proyectil con el escudo"
					type: "gamestage"
				}
			]
			title: "Detrás del escudo"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["19910FF2703E36B0"]
			description: ["&#19E6E6Zykna:&r &oEl diamante es lo más duro que da este mundo y casi nadie lo trae puesto. Bajar a buscarlo es un riesgo; que valga la pena depende de que luego lo uses.", "", "&6Qué hacer:&r Fabrica y ponte una pieza de armadura de diamante.", "", "&6Premio:&r 2 cosas al azar: lingotes de hierro, carbón, esmeraldas o carne cocida.", "&5A veces (7 %):&r una pechera de diamante encantada con Protección."]
			disable_toast: true
			icon: "minecraft:diamond_chestplate"
			id: "28AB3E7C30333961"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "55F5CA8CDC6365BB"
