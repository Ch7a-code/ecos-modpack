	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oLos barcos del Proyecto Éter no eran de madera noble: eran piezas que se armaban y se mandaban a donde hiciera falta. La coca es la más sencilla. Súbete, tómate del timón y aprende que el mar también obedece.", "", "&6Qué hacer:&r Consigue una coca de Small Ships, ponla en el agua y súbete. Con W avanzas, con A y D giras. Ya montado, la misión se cumple.", "", "&6Premio:&r 2 cosas al azar: tablones, cuerda, lana blanca o hierro.", "&5A veces (7 %):&r unas botas de hierro encantadas con Agilidad Acuática."]
			disable_toast: true
			icon: "smallships:sail"
			id: "76AD38BBF0C26C9C"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "4CA87A3B3C452739"
					icon: "smallships:sail"
					stage: "ecos_l_vehiculos_coca_montar"
					title: "Navega en una coca"
					type: "gamestage"
				}
			]
			title: "La primera vela"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["76AD38BBF0C26C9C"]
			description: ["&#19E6E6Zykna:&r &oLa carabela y el bergantín son ligeros y rápidos, hechos para rodear costas y volver con noticias. Quien los maneja bien llega a donde aún no llega ninguna colonia.", "", "&6Qué hacer:&r Navega en una carabela y en un bergantín de Small Ships. No tienen que ser tuyos: basta con subir y moverlos.", "", "&6Premio:&r 2 cosas al azar: cuerda, tablones, pescado cocido o hierro.", "&5A veces (7 %):&r un catalejo."]
			disable_toast: true
			icon: "minecraft:spyglass"
			id: "4545CF4B3835B693"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "70F6A3746171B534"
					icon: "smallships:sail"
					stage: "ecos_l_vehiculos_carabela_carabela"
					title: "Navega en una carabela"
					type: "gamestage"
				}
				{
