					type: "gamestage"
				}
			]
			title: "El buque de guerra"
			x: 0.00d
			y: 9.80d
		}
		{
			dependencies: ["6CD675BC7D010456"]
			description: ["&#19E6E6Zykna:&r &oCada nave tiene ranuras de mejora, como cada Eco tiene su astilla. Un motor mejor sube más rápido, una caldera mayor aguanta más peso. Esa es la diferencia entre llegar y quedarte a medio camino.", "", "&6Qué hacer:&r Consigue un motor (motor normal, ecológico o de Nether) y una caldera (normal o de acero) de Immersive Aircraft, y colócalos en las ranuras de tu nave.", "", "&6Premio:&r 2 cosas al azar: hierro, carbón, redstone o lingotes de acero.", "&5A veces (7 %):&r un yunque, para ensamblar mejoras."]
			disable_toast: true
			icon: "immersive_aircraft:engine"
			id: "7B8049B573EBA696"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "03142B5B9AB5A401"
					icon: "immersive_aircraft:engine"
					stage: "ecos_l_vehiculos_motores_motor"
					title: "Consigue un motor"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "48CDBD09F7FF1417"
