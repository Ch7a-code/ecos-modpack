			title: "La flota completa"
			x: 0.00d
			y: 4.20d
		}
		{
			dependencies: ["3BFB9F9C7FCAE4A2"]
			description: ["&#19E6E6Zykna:&r &oAntes de los cohetes hubo alas. El Proyecto lo sabía: si el aire se puede montar, el mundo se achica. El biplano es lo más sencillo que vuela. Tómalo con respeto y con la nariz arriba.", "", "&6Qué hacer:&r Arma un biplano de Immersive Aircraft, ponlo en un lugar plano, súbete y despega. Sube con W y baja con S.", "", "&6Premio:&r 2 cosas al azar: hélices, madera, hilo o hierro.", "&5A veces (7 %):&r unas botas de hierro encantadas con Caída de Pluma."]
			disable_toast: true
			icon: "immersive_aircraft:biplane"
			id: "45E1E97336F5E6C8"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "4B124FCBA3E88EDC"
					icon: "immersive_aircraft:biplane"
					stage: "ecos_l_vehiculos_biplano_volar"
					title: "Vuela en un biplano"
					type: "gamestage"
				}
			]
			title: "El primer vuelo"
			x: 0.00d
			y: 5.60d
		}
		{
			dependencies: ["45E1E97336F5E6C8"]
			description: ["&#19E6E6Zykna:&r &oEl dirigible no corre: flota. Su gran globo carga a varios Ecos y todo lo que quieran llevar. Es lento y silencioso, y eso lo hace perfecto para los que no quieren que la Fractura los oiga.", "", "&6Qué hacer:&r Arma un dirigible y un dirigible de carga de Immersive Aircraft. Súbete a cada uno y mantén altura sobre los árboles.", "", "&6Premio:&r 2 cosas al azar: lana, hilo, madera o hierro.", "&5A veces (7 %):&r un cofre de hierro de Sophisticated Storage."]
			disable_toast: true
			icon: "immersive_aircraft:airship"
			id: "2DF3652C5CFCE259"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "28ACFDB178D9D57B"
					icon: "immersive_aircraft:airship"
					stage: "ecos_l_vehiculos_dirigible_dirigible"
					title: "Vuela en un dirigible"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "56E3F62F3FAF12A8"
					icon: "immersive_aircraft:cargo_airship"
					stage: "ecos_l_vehiculos_dirigible_carga"
					title: "Vuela en un dirigible de carga"
					type: "gamestage"
				}
			]
			title: "Un globo con casco"
			x: 0.00d
			y: 7.00d
		}
		{
			dependencies: ["2DF3652C5CFCE259"]
			description: ["&#19E6E6Zykna:&r &oNo todo vuelo es en línea recta. El gyrodyne sube y baja como un abejorro, el quadrocóptero se queda quieto en el aire y la tolva de bambú se arma con lo que haya. Cada uno para un trabajo distinto.", "", "&6Qué hacer:&r Vuela un gyrodyne, un quadrocóptero y una tolva de bambú de Immersive Aircraft. Los tres se arman en la mesa de trabajo con sus piezas.", "", "&6Premio:&r 2 cosas al azar: hierro, madera, bambú o hilo.", "&5A veces (7 %):&r una pechera de hierro encantada con Protección."]
			disable_toast: true
			icon: "immersive_aircraft:gyrodyne"
			id: "26AA5E901978ED10"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "269035A4EB6D091D"
					icon: "immersive_aircraft:gyrodyne"
					stage: "ecos_l_vehiculos_rotores_gyro"
					title: "Vuela un gyrodyne"
