		}
		{
			dependencies: ["11CD6C3610E620CE"]
			description: ["&#19E6E6Zykna:&r &oEl Proyecto mandó robots a otros mundos antes de mandarse a sí mismo. El rover es de esos: seis ruedas, un asiento y la idea de que el suelo siempre ofrece camino. Funciona aquí igual que allá.", "", "&6Qué hacer:&r Arma un rover de Ad Astra, ponlo en tierra firme y súbete. Sirve para recorrer distancias largas y, más adelante, otros mundos.", "", "&6Premio:&r 2 cosas al azar: placas de hierro, varillas de hierro, acero o redstone.", "&5A veces (7 %):&r una pechera de hierro encantada con Protección."]
			disable_toast: true
			icon: "ad_astra:tier_1_rover"
			id: "5D0C68C0AA7241A1"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "718E987DCC001533"
					icon: "ad_astra:tier_1_rover"
					stage: "ecos_l_vehiculos_rover_montar"
					title: "Maneja un rover"
					type: "gamestage"
				}
			]
			title: "El rover"
			x: 0.00d
			y: 14.00d
		}
		{
			dependencies: ["5D0C68C0AA7241A1"]
			description: ["&#19E6E6Zykna:&r &oBajo el mar hay más historia que sobre él. El submarino te lleva a donde el aire no llega, con una luz propia y un casco que se aguanta la presión. Lo que ves ahí abajo es más viejo que la Fractura.", "", "&6Qué hacer:&r Arma un submarino de Alex's Caves, ponlo en el agua y sumérgete. Hazlo con luz, comida y no más profundo de lo que puedas volver.", "", "&6Premio:&r 2 cosas al azar: hierro, pescado cocido, lingotes de cobre o redstone.", "&5A veces (7 %):&r un casco de tortuga encantado con Respiración."]
			disable_toast: true
			icon: "alexscaves:submarine"
			id: "24D7D1FAB654C61E"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "7B6EA54B3CB24863"
					icon: "alexscaves:submarine"
					stage: "ecos_l_vehiculos_submarino_montar"
					title: "Sumérgete en un submarino"
					type: "gamestage"
				}
			]
			title: "Bajo la superficie"
			x: 0.00d
			y: 15.40d
		}
		{
			dependencies: ["24D7D1FAB654C61E"]
			description: ["&#19E6E6Zykna:&r &oAntes de los cohetes, el Proyecto tenía su propia red: piedras de relevo que se hablaban entre sí y movían a quien las tocaba. Siguen vivas, pero cobran experiencia. El Éter no regala nada.", "", "&6Qué hacer:&r Pon un waystone en tu refugio, actívalo con clic derecho y pon otro lejos. Cada vez que viajes entre ellos te costará experiencia.", "", "&6Premio:&r 2 cosas al azar: polvo de salto, esmeraldas, oro o pan.", "&5A veces (7 %):&r una piedra de salto."]
			disable_toast: true
			icon: "waystones:waystone"
			id: "67A53F86DFC7C6E1"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
					id: "2AFFAB1A1ED65723"
					icon: "waystones:waystone"
					stage: "ecos_l_vehiculos_waystone_poner"
					title: "Pon un waystone"
					type: "gamestage"
				}
			]
			title: "La red de relevos"
			x: 2.50d
			y: 0.00d
		}
		{
			dependencies: ["67A53F86DFC7C6E1"]
			description: ["&#19E6E6Zykna:&r &oLos relevos no son solo piedras. Hay losas que te lanzan, pergaminos que te devuelven y piedras que te llevan a casa. Cada una cobra a su manera. Elige la que cuadre con tu bolsillo de experiencia.", "", "&6Qué hacer:&r Pon una losa de salto, o una piedra compartida, o una portstone. Consigue además un pergamino de waystones o una piedra de salto.", "", "&6Premio:&r 2 cosas al azar: polvo de salto, esmeraldas, oro o diamante.", "&5A veces (7 %):&r un pergamino de retorno."]
			disable_toast: true
			icon: "waystones:warp_scroll"
			id: "4C5EDD769AAE95E3"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
					id: "3459C49CA576710D"
					icon: "waystones:warp_plate"
					stage: "ecos_l_vehiculos_relevos_colocar"
					title: "Pon una losa de salto o una piedra compartida"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "303DFB83D806A0C6"
					icon: "waystones:warp_scroll"
					stage: "ecos_l_vehiculos_relevos_objeto"
					title: "Consigue un pergamino o una piedra de salto"
					type: "gamestage"
				}
			]
			title: "Viajar sin caminar"
			x: 2.50d
			y: 1.40d
		}
	]
	subtitle: ["Barcos, aeronaves, un rover y un submarino: tecnología del Proyecto Éter reconstruida.", "Desde la Era II, los waystones: la vieja red de relevos."]
	title: "Vehículos y relevos"
}
