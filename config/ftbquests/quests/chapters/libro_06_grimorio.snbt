		}
		{
			dependencies: ["058D56EF8FE6CF1E"]
			description: ["&#19E6E6Zykna:&r &oEn la Era III los hechizos épicos dejan de ser rumor. Una tinta épica aguanta lo que una común no soportaría ni una vez: una página puede cambiar una batalla. Escríbelos con respeto.", "", "&6Qué hacer:&r Cuando el mundo llegue a la Era III, reúne una tinta épica para escribir hechizos épicos.", "", "&6Premio:&r 2 cosas al azar: diamantes, oro, frascos de experiencia o tinta rara.", "&5A veces (7 %):&r chatarra de netherita."]
			disable_toast: true
			icon: "irons_spellbooks:epic_ink"
			id: "703BD4998C97309C"
			shape: "diamond"
			size: 1.00d
