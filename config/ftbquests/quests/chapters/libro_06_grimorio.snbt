		}
		{
			dependencies: ["5D6F91F929B2A14C"]
			description: ["&#19E6E6Zykna:&r &oEn la Era II el Éter aprende a doblar el camino: teletransporte, recall, portal. Un paso aquí y otro allá, sin cruzar lo de en medio. No es gratis: cada salto cuesta maná y atención.", "", "&6Qué hacer:&r En la Era II, forja un pergamino de teletransporte, recall o portal y tenlo en tu inventario. Se lanza igual que cualquier hechizo.", "", "&6Premio:&r 2 cosas al azar: perlas de Ender, frascos de experiencia, lapislázuli o amatista.", "&5A veces (7 %):&r varias perlas de Ender."]
			disable_toast: true
			icon: "minecraft:ender_pearl"
			id: "7BB0B91F4F959F72"
			shape: "square"
			size: 1.00d
			subtitle: "Era II · Los Cielos"
			tasks: [
				{
					disable_toast: true
					id: "7C4206DBC0B6FA4F"
