	quest_links: [ ]
	quests: [
		{
			description: ["&#19E6E6Zykna:&r &oLos hechizos obedecen a la voz, pero antes hay que escribirlos. La mesa de inscripción es donde un pergamino en blanco empieza a ser hechizo. Aprende a usarla y el Éter te escucha mejor.", "", "&6Qué hacer:&r Fabrica una Mesa de Inscripción de Iron's Spells y ponla en tu refugio.", "", "&6Premio:&r 2 cosas al azar: papel, lapislázuli, amatista o libros.", "&5A veces (7 %):&r tinta poco común para tus primeros pergaminos."]
			disable_toast: true
			icon: "irons_spellbooks:inscription_table"
			id: "0F00F0F5B84260C5"
			shape: "hexagon"
			size: 1.30d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "34172D90B045E153"
					icon: "irons_spellbooks:inscription_table"
					stage: "ecos_l_grimorio_mesa_crear"
					title: "Crea una mesa de inscripción"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "33DB0F966E7241D8"
					icon: "irons_spellbooks:inscription_table"
					stage: "ecos_l_grimorio_mesa_poner"
					title: "Ponla en tu refugio"
					type: "gamestage"
				}
			]
			title: "Escribano pintoresco"
			x: 0.00d
			y: 0.00d
		}
		{
			dependencies: ["0F00F0F5B84260C5"]
			description: ["&#19E6E6Zykna:&r &oUn pergamino de hechizo no se escribe a mano: se forja. La Forja de Pergaminos junta papel, tinta y un poco de Éter hasta que la página queda cargada. Es la primera magia que se puede guardar en el bolsillo.", "", "&6Qué hacer:&r Fabrica una Forja de Pergaminos y forja un pergamino de hechizo. Tenlo en tu inventario.", "", "&6Premio:&r 2 cosas al azar: tinta común, papel, frascos de experiencia o frascos de vidrio.", "&5A veces (7 %):&r tinta poco común, varias."]
			disable_toast: true
			icon: "irons_spellbooks:scroll_forge"
			id: "5E942FC908923B0F"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "29C4B21CEDF3643E"
					icon: "irons_spellbooks:scroll_forge"
					stage: "ecos_l_grimorio_forja_forja"
					title: "Crea una Forja de Pergaminos"
					type: "gamestage"
				}
				{
					disable_toast: true
					id: "458707BA5E1C915F"
					icon: "irons_spellbooks:scroll"
					stage: "ecos_l_grimorio_forja_pergamino"
					title: "Ten un pergamino de hechizo"
					type: "gamestage"
				}
			]
			title: "Papel que se forja"
			x: 0.00d
			y: 1.40d
		}
		{
			dependencies: ["5E942FC908923B0F"]
			description: ["&#19E6E6Zykna:&r &oUn pergamino se gasta al usarlo. Un grimorio guarda los hechizos para siempre y los pone al alcance de tu mano. Cada libro tiene espacios: úsalos con cabeza, que no caben todos.", "", "&6Qué hacer:&r Consigue un libro de hechizos y equípalo en tu espacio de libro. Ábrelo y guarda en él un hechizo.", "", "&6Premio:&r 2 cosas al azar: libros, lapislázuli, cuero o frascos de experiencia.", "&5A veces (7 %):&r un libro de hechizos de cobre."]
			disable_toast: true
			icon: "irons_spellbooks:copper_spell_book"
			id: "3CF07D71B9C91ECE"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "42CC6DB1ADBBFD9A"
					icon: "irons_spellbooks:copper_spell_book"
					stage: "ecos_l_grimorio_libro_equipar"
					title: "Equipa un libro de hechizos"
					type: "gamestage"
				}
			]
			title: "Tu primer grimorio"
			x: 0.00d
			y: 2.80d
		}
		{
			dependencies: ["3CF07D71B9C91ECE"]
			description: ["&#19E6E6Zykna:&r &oEl Éter viaja por el sonido. Los monstruos te oyen, y los hechizos también: con Incantation no aprietas una tecla, dices el nombre del hechizo en voz alta y se cumple.", "", "&6Qué hacer:&r Con un hechizo en tu libro, di su nombre en voz alta frente al micrófono. Necesitas micrófono activo en el juego.", "", "&6Premio:&r 2 cosas al azar: frascos de experiencia, amatista, lapislázuli o papel.", "&5A veces (7 %):&r un montón de frascos de experiencia."]
			disable_toast: true
			icon: "minecraft:note_block"
			id: "767812D97395FFCE"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
				{
					disable_toast: true
					id: "2BF4F604AFF4C9FA"
					icon: "minecraft:note_block"
					stage: "ecos_l_grimorio_voz_primera"
					title: "Lanza tu primer hechizo con la voz"
					type: "gamestage"
				}
			]
			title: "Di la palabra"
			x: 0.00d
			y: 4.20d
		}
		{
			dependencies: ["767812D97395FFCE"]
			description: ["&#19E6E6Zykna:&r &oPara mejorar un objeto con Éter hace falta un yunque que lo entienda. El yunque arcano funde, mejora y repara lo que la magia toca. Es tu primer taller de verdad.", "", "&6Qué hacer:&r Fabrica un Yunque Arcano y ponlo en tu refugio.", "", "&6Premio:&r 2 cosas al azar: hierro, lapislázuli, esencia arcana o amatista.", "&5A veces (7 %):&r esencia arcana extra."]
			disable_toast: true
			icon: "irons_spellbooks:arcane_anvil"
			id: "4C4C89830DE577F7"
			shape: "circle"
			size: 1.00d
			subtitle: "Era 0 · El Despertar"
			tasks: [
