{
  PresetMetadata:{author:"ECOS",category:"ECOS",created:1763280000000L,description:"Maestro de la familia elementales (ECOS v12.1). Generado por tools/gen_maestros.py; no editar a mano.",entityTypeId:"easy_npc:humanoid_slim",modified:1763280000000L,name:"Citlali, la Tejedora de Tormentas",variantType:"MAGE_01",version:"1.0.0"},
  data:{
    id:"easy_npc:humanoid_slim",
    EasyNPCVersion:3,
    VariantType:"MAGE_01",
    CustomName:'{"text": "Citlali, la Tejedora de Tormentas", "color": "#7FD4FF"}',
    CustomNameVisible:1b,
    Invulnerable:1b,
    PersistenceRequired:1b,
    CanPickUpLoot:0b,
    Tags:["ecos_maestro_npc","ecos_maestro_npc_elementales"],
    SkinData:{Type:"RESOURCE_LOCATION",Texture:"ecos:textures/entity/maestro/elementales.png"},
    Attributes:[{Base:0.0d,Name:"minecraft:generic.movement_speed"},{Base:1.0d,Name:"minecraft:generic.knockback_resistance"}],
    EntityAttribute:{IsInvulnerable:1b,IsAttackableByPlayers:0b,IsAttackableByMonsters:0b,IsKnockbackResistant:1b,IsExplosionResistant:1b,IsPushable:0b,PushEntities:0b,CanBeLeashed:0b},
    ObjectiveData:{ObjectiveDataSet:[{Type:"LOOK_AT_RESET"},{Type:"LOOK_AT_PLAYER"},{Type:"LOOK_AT_MOB"}]},
    ActionData:{ActionEventSet:{ON_INTERACTION:[{Type:"COMMAND",Cmd:"/execute as @initiator run zykna maestro elementales hablar",PermLevel:2},{Type:"OPEN_DEFAULT_DIALOG"}]}},
    DialogData:{Type:"CUSTOM",DialogDataSet:[
      {Name:"Bendicion",Label:"bendicion",Priority:100,Texts:[{Text:"Llevas mi marca, @initiator. Cuando truene, sabrás que dice tu nombre.\\n\\nVuelve cuando quieras; el viento sabe dónde estoy."}],Conditions:[{Type:"PLAYER_TAG",Name:"ecos_maestro_elementales_g2"}],Buttons:[{Name:"Gracias",Label:"b_gracias",Actions:[{Type:"CLOSE_DIALOG"}]}]},
      {Name:"Lista",Label:"lista",Priority:50,Texts:[{Text:"Hueles a lluvia, @initiator. Ya cumpliste.\\n\\nVen: recibe mi marca."}],Conditions:[{Type:"PLAYER_TAG",Name:"ecos_maestro_elementales_lista"}],Buttons:[{Name:"Recibir tu marca",Label:"b_marca",Actions:[{Type:"COMMAND",Cmd:"/execute as @initiator run zykna maestro elementales marca",PermLevel:2},{Type:"CLOSE_DIALOG"}]},{Name:"Todavía no",Label:"b_luego",Actions:[{Type:"CLOSE_DIALOG"}]}]},
      {Name:"Progreso",Label:"progreso",Priority:20,Texts:[{Text:"El cielo cambia, @initiator, y tú también. Llevas @score(ecos_mpasos) de 5 pasos.\\n\\nLa tormenta no tiene prisa; por eso nunca falla."}],Conditions:[{Type:"PLAYER_TAG",Name:"ecos_maestro_elementales_aceptada"}],Buttons:[{Name:"¿Qué me falta?",Label:"b_pasos",Actions:[{Type:"COMMAND",Cmd:"/execute as @initiator run zykna maestro elementales pasos",PermLevel:2},{Type:"CLOSE_DIALOG"}]},{Name:"Me voy",Label:"b_adios",Actions:[{Type:"CLOSE_DIALOG"}]}]},
      {Name:"Saludo",Label:"saludo",Priority:10,Texts:[{Text:"Llegaste con el viento, @initiator. Soy Citlali. Medía el cielo del Proyecto, y cuando el Éter estalló, el clima se quedó conmigo.\\n\\nTu astilla tiembla como la mía. Si quieres mi marca, aprende a pedirle al agua y al fuego, no a darles órdenes."}],Conditions:[{Type:"PLAYER_TAG",Name:"ecos_fam_elementales"}],Buttons:[{Name:"Acepto tu prueba",Label:"b_acepto",Actions:[{Type:"COMMAND",Cmd:"/execute as @initiator run zykna maestro elementales aceptar",PermLevel:2},{Type:"OPEN_NAMED_DIALOG",Cmd:"aceptada"}]},{Name:"¿Quién eres?",Label:"b_quien",Actions:[{Type:"OPEN_NAMED_DIALOG",Cmd:"quien"}]},{Name:"Ahora no",Label:"b_ahora_no",Actions:[{Type:"CLOSE_DIALOG"}]}]},
      {Name:"Ajeno",Label:"ajeno",Priority:0,Texts:[{Text:"Tu astilla no responde al cielo, @initiator. Mi marca no te serviría.\\n\\nTu Maestro te espera en otro lado. Pregúntale a Zykna."}],Buttons:[{Name:"¿Quién eres?",Label:"b_quien",Actions:[{Type:"OPEN_NAMED_DIALOG",Cmd:"quien"}]},{Name:"Me voy",Label:"b_adios",Actions:[{Type:"CLOSE_DIALOG"}]}]},
      {Name:"Quien",Label:"quien",Priority:-1,Texts:[{Text:"Mi nombre quiere decir estrella. Fui meteoróloga del Proyecto.\\n\\nCuando el Éter estalló, mi astilla se aferró a lo único estable: estas islas sin suelo. No soy diosa de la lluvia; solo recuerdo de dónde nace."}],Buttons:[{Name:"Volver",Label:"b_volver",Actions:[{Type:"OPEN_DEFAULT_DIALOG"}]},{Name:"Me voy",Label:"b_adios",Actions:[{Type:"CLOSE_DIALOG"}]}]},
      {Name:"Aceptada",Label:"aceptada",Priority:-1,Texts:[{Text:"Bien. Son cinco pasos. El primero es el camino hasta estas islas y vencer a mi guardiana.\\n\\nZykna te los dice. Cuando estén hechos, vuelve y tejo mi marca en ti."}],Buttons:[{Name:"Entendido",Label:"b_entendido",Actions:[{Type:"CLOSE_DIALOG"}]}]}
    ]},
    Status:{finalized:1b}
  }
}
